---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import Timeline from "@/components/Timeline.astro";
import CredentialList from "@/components/CredentialList.astro";
import JsonLd from "@/components/JsonLd.astro";
import juntas from "@/assets/images/daniela-juntas.webp";
import { SITE, whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";
---

<Layout
  title="Perfil profesional"
  description="Trayectoria de Dra. Daniela Jaramillo: ocho años en la Fiscalía General de la Nación, Magíster y Especialista en Derecho Procesal Penal, abogada titulada de la Universidad EAFIT."
  path="/perfil"
>
  <PageHero
    title="Ocho años construyendo casos en la Fiscalía"
    lead="Antes de ejercer la defensa privada, Daniela pasó casi una década construyendo casos penales dentro de la Fiscalía General de la Nación. Esa experiencia es la base de cómo hoy defiende."
    image={juntas}
    imageAlt="Daniela Jaramillo dirigiendo una reunión de trabajo sobre un proceso penal"
    imageAspect="4 / 5"
  />

  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <div class="prose-editorial" data-reveal>
        <p>
          Dra. Daniela Jaramillo es abogada, magíster en Derecho Procesal Penal y Teoría del
          Delito, y especialista en Derecho Procesal Penal. Su formación y su trayectoria están
          orientadas en una sola dirección: entender el proceso penal desde adentro para
          defenderlo con precisión desde afuera.
        </p>
        <p>
          Durante ocho años trabajó como asistente de fiscal en la Dirección Especializada Contra
          las Organizaciones Criminales (DECOC) de la Fiscalía General de la Nación en Medellín,
          la unidad que investiga estructuras de crimen organizado en la ciudad y en el país.
          Allí proyectó escritos de acusación directos y por aceptación de cargos, acompañó
          audiencias, entrevistas, declaraciones e interrogatorios, emitió órdenes a policía
          judicial y gestionó el sistema misional SPOA en cientos de actuaciones procesales.
        </p>
        <p>
          Por reserva de la investigación, Daniela no puede ni pretende hacer referencia a casos
          concretos de su paso por la Fiscalía. Lo que sí puede ofrecer es el criterio que esa
          experiencia deja: saber qué mira realmente un fiscal antes de imputar, qué hace sólido
          o débil un preacuerdo, y qué esperar en cada etapa del proceso — no desde la teoría, sino
          desde haber estado en la sala.
        </p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2">
        <div class="border border-manila-300 bg-manila-100 p-6">
          <p class="block-label text-sello-600">Tarjeta profesional</p>
          <p class="mt-2 font-display text-lg font-semibold text-ink-900">
            N.° {SITE.tarjetaProfesional}
          </p>
          <p class="mt-1 text-sm text-manila-700">{SITE.tarjetaProfesionalConsejo}</p>
        </div>
        <div class="border border-manila-300 bg-manila-100 p-6">
          <p class="block-label text-sello-600">Idiomas</p>
          <p class="mt-2 text-sm text-manila-700">
            <span class="font-medium text-ink-900">Español</span> — nativo
          </p>
          <p class="mt-1 text-sm text-manila-700">
            <span class="font-medium text-ink-900">Inglés</span> — nivel intermedio
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl" data-reveal>
        Trayectoria
      </h2>
      <div class="mt-10 border border-manila-300 bg-manila-50 p-6 sm:p-10" data-reveal style="--reveal-delay: 100ms">
        <Timeline />
      </div>
    </div>
  </section>

  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
        Formación académica
      </h2>
      <div class="mt-10">
        <CredentialList />
      </div>
    </div>
  </section>

  <section class="bg-manila-100 py-14 sm:py-16">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
      data-reveal
    >
      <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">
        ¿Quieres contarle tu caso?
      </h2>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-primary
          class="btn-gold whitespace-nowrap"
        >
          WhatsApp directo
        </a>
        <a href="/contacto" class="btn-outline-gold whitespace-nowrap">
          Ir al formulario
        </a>
      </div>
    </div>
  </section>

  <JsonLd
    schema={{
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      dateCreated: "2026-09-15",
      mainEntity: {
        "@type": "Person",
        name: SITE.name,
        jobTitle: SITE.role,
        url: `${SITE.url}/perfil`,
        knowsLanguage: ["es", "en"],
        hasCredential: [
          "Abogada — Universidad EAFIT (2023)",
          "Especialista en Derecho Procesal Penal — UNAULA (2024)",
          "Magíster en Derecho Procesal Penal y Teoría del Delito — UNAULA (2026)",
          `Tarjeta Profesional N.° ${SITE.tarjetaProfesional} — ${SITE.tarjetaProfesionalConsejo}`,
        ],
      },
    }}
  />
</Layout>
