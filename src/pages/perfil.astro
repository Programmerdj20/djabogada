---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Timeline from "@/components/Timeline.astro";
import CredentialList from "@/components/CredentialList.astro";
import JsonLd from "@/components/JsonLd.astro";
import perfil from "@/assets/images/daniela-perfil.webp";
import { AREAS, SITE, whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";
---

<Layout
  title="Perfil de Daniela Jaramillo, abogada penalista en Medellín"
  description="Daniela Jaramillo: ocho años como asistente de fiscal en la unidad contra el crimen organizado de la Fiscalía General de la Nación, magíster y especialista en Derecho Procesal Penal. Hoy ejerce la defensa penal en Medellín."
  path="/perfil"
>
  <!-- PLACA DE RETRATO: mismo lenguaje de material que el hero desktop del
       home (filete oro, hero-rise, placa con marco sello-400/sello-300),
       sin el passe-partout desplazado, que es exclusivo del home. -->
  <section class="border-b border-manila-300 bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16">
        <div class="order-2 lg:order-1">
          <span class="rule-gold rule-draw block w-24" aria-hidden="true" style="--rise-delay: 0ms"></span>

          <h1 class="hero-rise mt-6 font-display font-semibold text-ink-900" style="--rise-delay: 90ms">
            <span class="block text-4xl leading-[1.05] sm:text-5xl lg:text-[3.25rem]">
              Daniela Jaramillo
            </span>
            <span class="sr-only">, </span>
            <span class="mt-3 flex items-center gap-3">
              <span class="h-4 w-px shrink-0 bg-sello-400" aria-hidden="true"></span>
              <span class="font-sans text-sm font-semibold uppercase tracking-[0.28em] text-sello-700">
                Abogada penalista
              </span>
            </span>
          </h1>

          <p
            class="hero-rise mt-6 max-w-lg font-display text-2xl font-semibold leading-[1.25] text-ink-900 sm:text-3xl"
            style="--rise-delay: 170ms"
          >
            Antes de defender, construyó acusaciones dentro de la Fiscalía. Hoy ese criterio es la base de su defensa penal.
          </p>

          <p class="hero-rise mt-5 max-w-md text-base leading-relaxed text-manila-700 sm:text-lg" style="--rise-delay: 230ms">
            Magíster y especialista en Derecho Procesal Penal, abogada de la Universidad EAFIT, y ocho
            años dentro de la unidad de la Fiscalía especializada contra el crimen organizado.
          </p>

          <dl class="hero-rise mt-9 divide-y divide-sello-400 border-t border-sello-400" style="--rise-delay: 300ms">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
              <dt class="folio-kicker text-sello-600">2018 — 2026</dt>
              <dd class="font-display text-lg font-semibold text-ink-900">
                Ocho años en la Fiscalía General de la Nación
              </dd>
            </div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
              <dt class="folio-kicker text-sello-600">DECOC</dt>
              <dd class="font-display text-lg font-semibold text-ink-900">
                Unidad especializada contra organizaciones criminales
              </dd>
            </div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
              <dt class="folio-kicker text-sello-600">UNAULA</dt>
              <dd class="font-display text-lg font-semibold text-ink-900">
                Magíster y Especialista en Derecho Procesal Penal
              </dd>
            </div>
          </dl>
        </div>

        <div class="hero-rise relative order-1 mx-auto w-full max-w-xs lg:order-2 lg:mx-0 lg:max-w-none" style="--rise-delay: 130ms">
          <div class="hero-settle relative border border-sello-400 bg-manila-50 p-3 shadow-gold sm:p-4">
            <div class="border border-sello-300 p-1">
              <Picture
                src={perfil}
                alt="Daniela Jaramillo, abogada penalista en Medellín, en su oficina"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[420, 560, 720, 960]}
                sizes="(min-width: 1024px) 32vw, (min-width: 640px) 58vw, 82vw"
                class="w-full object-cover"
                style="aspect-ratio: 2 / 3; object-position: center 14%;"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BIOGRAFÍA -->
  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl" data-reveal>
        Quién es Daniela Jaramillo
      </h2>
      <div class="prose-editorial mt-8" data-reveal style="--reveal-delay: 80ms">
        <p>
          Daniela Jaramillo es abogada de la Universidad EAFIT, magíster en Derecho Procesal Penal
          y Teoría del Delito y especialista en Derecho Procesal Penal, ambos títulos de la
          Universidad Autónoma Latinoamericana (UNAULA). Su formación y su trayectoria apuntan en
          una sola dirección: entender el proceso penal desde adentro para defenderlo con
          precisión desde afuera.
        </p>
        <p>
          Durante ocho años, entre 2018 y 2026, trabajó como asistente de fiscal en la Dirección
          Especializada Contra las Organizaciones Criminales (DECOC) de la Fiscalía General de la
          Nación en Medellín, la unidad que investiga estructuras de crimen organizado en la ciudad
          y en el país. Allí proyectó escritos de acusación directos y por aceptación de cargos,
          acompañó audiencias, entrevistas, declaraciones e interrogatorios, emitió órdenes a
          policía judicial y gestionó el sistema misional SPOA.
        </p>
        <p>
          Por reserva de la investigación, Daniela no puede ni pretende hacer referencia a casos
          concretos de su paso por la Fiscalía. Lo que sí traslada a su ejercicio privado es el
          criterio que deja esa experiencia: saber qué evidencia sostiene realmente una imputación,
          qué hace sólido o débil un preacuerdo, y qué esperar en cada etapa del
          <a href="/proceso-penal">proceso penal</a> — no desde la teoría, sino desde haber estado
          en la sala.
        </p>
        <p>
          Hoy ejerce la <a href="/servicios/defensa-penal">defensa penal</a> privada en Medellín y
          Antioquia, acompaña a <a href="/servicios/representacion-de-victimas">víctimas</a> y sus
          familias dentro del proceso penal, y asesora en casos de
          <a href="/servicios/criminalidad-organizada">criminalidad organizada</a> y delitos complejos.
        </p>
      </div>
    </div>
  </section>

  <!-- TRAYECTORIA -->
  <section class="bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl" data-reveal>
        Trayectoria
      </h2>
      <div class="mt-10 border border-manila-300 bg-manila-50 p-6 sm:p-10" data-reveal style="--reveal-delay: 100ms">
        <Timeline />
      </div>
    </div>
  </section>

  <!-- FORMACIÓN E IDIOMAS -->
  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl" data-reveal>
        Formación académica
      </h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-[1.4fr_0.6fr] lg:items-start" data-reveal style="--reveal-delay: 80ms">
        <CredentialList />

        <div class="border border-manila-300 bg-manila-100 p-6">
          <p class="block-label text-sello-600">Idiomas</p>
          <p class="mt-3 text-sm text-manila-700">
            <span class="font-medium text-ink-900">Español</span> — nativo
          </p>
          <p class="mt-1 text-sm text-manila-700">
            <span class="font-medium text-ink-900">Inglés</span> — nivel intermedio
          </p>

          <p class="mt-6 border-t border-manila-300 pt-4 text-sm leading-relaxed text-manila-700">
            Tarjeta profesional vigente, expedida por el Consejo Superior de la Judicatura,
            Seccional Antioquia.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-manila-100 py-16 sm:py-20">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
      data-reveal
    >
      <div>
        <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">
          ¿Quieres contarle tu caso a Daniela?
        </h2>
        <p class="mt-2 max-w-lg text-manila-700">
          Cuanto antes tenga claridad sobre tu situación, más opciones reales podrá evaluar
          contigo.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-primary
          class="btn-gold whitespace-nowrap"
        >
          WhatsApp directo
        </a>
        <a href="/contacto" class="btn-outline-gold whitespace-nowrap">
          Formulario de contacto
        </a>
      </div>
    </div>
  </section>

  <JsonLd
    schema={{
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      dateCreated: "2026-09-15",
      dateModified: "2026-09-24",
      mainEntity: {
        "@type": "Person",
        name: SITE.name,
        jobTitle: SITE.role,
        description:
          "Abogada penalista en Medellín. Ocho años como asistente de fiscal en la unidad de la Fiscalía General de la Nación contra el crimen organizado; hoy ejerce la defensa penal, la representación de víctimas y la asesoría en criminalidad organizada.",
        url: `${SITE.url}/perfil`,
        knowsLanguage: ["es", "en"],
        knowsAbout: AREAS.map((a) => a.title),
        address: {
          "@type": "PostalAddress",
          addressLocality: SITE.city,
          addressRegion: SITE.region,
          addressCountry: "CO",
        },
        alumniOf: [
          { "@type": "CollegeOrUniversity", name: "Universidad EAFIT" },
          { "@type": "CollegeOrUniversity", name: "Universidad Autónoma Latinoamericana (UNAULA)" },
        ],
        hasCredential: [
          {
            "@type": "EducationalOccupationalCredential",
            credentialCategory: "degree",
            name: "Abogada — Universidad EAFIT",
          },
          {
            "@type": "EducationalOccupationalCredential",
            credentialCategory: "postgraduate degree",
            name: "Especialista en Derecho Procesal Penal — UNAULA",
          },
          {
            "@type": "EducationalOccupationalCredential",
            credentialCategory: "postgraduate degree",
            name: "Magíster en Derecho Procesal Penal y Teoría del Delito — UNAULA",
          },
        ],
      },
    }}
  />
</Layout>
