---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import JsonLd from "@/components/JsonLd.astro";
import perfil from "@/assets/images/daniela-perfil.webp";
import { AREAS, CREDENTIALS, SITE, TIMELINE, whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";
---

<Layout
  title="Perfil de Daniela Jaramillo, abogada penalista en Medellín"
  description="Daniela Jaramillo, abogada penalista en Medellín: más de ocho años en la Fiscalía General de la Nación, Dirección Especializada contra las Organizaciones Criminales, hoy en ejercicio independiente de defensa técnica, asesoría penal estratégica y representación de víctimas."
  path="/perfil"
>
  <!-- PLACA DE RETRATO: mismo lenguaje de material que el hero desktop del
       home (filete oro, hero-rise, placa con marco sello-400/sello-300),
       sin el passe-partout desplazado, que es exclusivo del home. -->
  <section class="border-b border-manila-300 bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16">
        <div class="order-2 lg:order-1">
          <span class="rule-gold rule-draw block w-24" aria-hidden="true" style="--rise-delay: 0ms"></span>

          <h1 class="hero-rise mt-6 font-display font-semibold text-ink-900" style="--rise-delay: 90ms">
            <span class="block text-4xl leading-[1.05] sm:text-5xl lg:text-[3.25rem]">
              Daniela Jaramillo
            </span>
            <span class="sr-only">, </span>
            <span class="mt-3 flex items-center gap-3">
              <span class="h-4 w-px shrink-0 bg-sello-400" aria-hidden="true"></span>
              <span class="font-sans text-sm font-semibold uppercase tracking-[0.28em] text-sello-700">
                Abogada penalista
              </span>
            </span>
          </h1>

          <p
            class="hero-rise mt-6 max-w-lg font-display text-2xl font-semibold leading-[1.25] text-ink-900 sm:text-3xl"
            style="--rise-delay: 170ms"
          >
            Abogada, Especialista en Derecho Procesal Penal y Magíster en Derecho Procesal Penal y
            Teoría del Delito.
          </p>
        </div>

        <div class="hero-rise relative order-1 mx-auto w-full max-w-xs lg:order-2 lg:mx-0 lg:max-w-none" style="--rise-delay: 130ms">
          <div class="hero-settle relative border border-sello-400 bg-manila-50 p-3 shadow-gold sm:p-4">
            <div class="border border-sello-300 p-1">
              <Picture
                src={perfil}
                alt="Daniela Jaramillo, abogada penalista en Medellín, en su oficina"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[420, 560, 720, 960]}
                sizes="(min-width: 1024px) 32vw, (min-width: 640px) 58vw, 82vw"
                class="w-full object-cover"
                style="aspect-ratio: 2 / 3; object-position: center 14%;"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CARTA: la cita se destaca primero como divisor editorial —el mismo
       gesto de filete de oro que abre el hero— y da paso a su texto de
       perfil completo, en primera persona, tal como lo escribió. -->
  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <figure class="text-center" data-reveal>
        <span class="rule-gold mx-auto block w-16" aria-hidden="true"></span>
        <blockquote class="mt-7 font-display text-2xl font-medium italic leading-snug text-ink-900 sm:text-3xl">
          “Mi ejercicio profesional se fundamenta en el estudio riguroso de cada asunto, la
          construcción de soluciones jurídicas sólidas y el acompañamiento cercano y
          personalizado durante cada etapa del proceso.”
        </blockquote>
        <span class="rule-gold mx-auto mt-7 block w-16" aria-hidden="true"></span>
      </figure>

      <h2 class="mt-16 font-display text-3xl font-semibold text-ink-900 sm:text-4xl" data-reveal>
        Quién es Daniela Jaramillo
      </h2>
      <div class="prose-editorial mt-8" data-reveal style="--reveal-delay: 80ms">
        <p>
          Mi trayectoria profesional se ha desarrollado principalmente en el ámbito del derecho
          penal. Durante más de ocho años hice parte de la Fiscalía General de la Nación,
          adscrita a la Dirección Especializada contra las Organizaciones Criminales,
          participando en investigaciones de especial complejidad y en diversas actuaciones
          propias de la investigación y el proceso penal. Esta experiencia me permitió conocer de
          cerca la dinámica del sistema de justicia penal y adquirir una visión integral sobre la
          construcción, análisis y litigio de los casos penales.
        </p>
        <p>
          Actualmente ejerzo de manera independiente, poniendo esa experiencia al servicio de la <a href="/servicios#area-defensa-penal">defensa técnica</a>, la <a href="/servicios#area-asesoria-penal-estrategica">asesoría penal estratégica</a> y la <a href="/servicios#area-representacion-de-victimas">representación de víctimas</a>, con un
          enfoque basado en el análisis jurídico, la estrategia procesal y la protección efectiva
          de los derechos e intereses de cada cliente.
        </p>
        <p>
          Mi ejercicio profesional se fundamenta en el estudio riguroso de cada asunto, la
          construcción de soluciones jurídicas sólidas y el acompañamiento cercano y
          personalizado durante cada etapa del <a href="/proceso-penal">proceso penal</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- FORMACIÓN Y TRAYECTORIA: una sola ficha —no una cronología para un
       único punto, ni una lista de créditos separada—, en dos columnas que
       se leen como un mismo documento. -->
  <section class="bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl" data-reveal>
        Formación y trayectoria
      </h2>
      <div
        class="mt-10 grid gap-10 border border-manila-300 bg-manila-50 p-6 sm:p-10 lg:grid-cols-2 lg:gap-14"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        <div>
          <p class="block-label text-sello-700">Formación académica</p>
          <ul class="mt-5 divide-y divide-manila-300 border-t border-manila-300">
            {
              CREDENTIALS.map((c) => (
                <li class="py-4 first:pt-0">
                  <p class="font-display text-lg text-ink-900">{c.title}</p>
                  <p class="mt-0.5 text-sm text-manila-700">{c.org}</p>
                  {c.detail && <p class="mt-1 text-sm text-manila-700">{c.detail}</p>}
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="block-label text-sello-700">Trayectoria</p>
          <div class="mt-5 border-t border-manila-300 pt-5">
            {
              TIMELINE.map((entry) => (
                <div>
                  <p class="folio-kicker text-sello-700">{entry.range}</p>
                  <p class="mt-1 font-display text-lg text-ink-900">{entry.title}</p>
                  <p class="mt-0.5 text-sm font-medium text-manila-700">{entry.org}</p>
                  <p class="mt-3 text-sm leading-relaxed text-manila-700">{entry.detail}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-manila-50 py-16 sm:py-20">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
      data-reveal
    >
      <div>
        <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">
          ¿Quieres contarle tu caso a Daniela?
        </h2>
        <p class="mt-2 max-w-lg text-manila-700">
          Cuanto antes tenga claridad sobre tu situación, más opciones reales podrá evaluar
          contigo.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-primary
          class="btn-gold whitespace-nowrap"
        >
          WhatsApp directo
        </a>
        <a href="/contacto" class="btn-outline-gold whitespace-nowrap">
          Formulario de contacto
        </a>
      </div>
    </div>
  </section>

  <JsonLd
    schema={{
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      dateCreated: "2026-09-15",
      dateModified: "2026-09-24",
      mainEntity: {
        "@type": "Person",
        name: SITE.name,
        jobTitle: SITE.role,
        description:
          "Abogada penalista en Medellín. Más de ocho años en la Fiscalía General de la Nación, Dirección Especializada contra las Organizaciones Criminales, participando en investigaciones y actuaciones del proceso penal; hoy ejerce de forma independiente la defensa técnica, la asesoría penal estratégica y la representación de víctimas.",
        url: `${SITE.url}/perfil`,
        knowsAbout: AREAS.map((a) => a.title),
        address: {
          "@type": "PostalAddress",
          addressLocality: SITE.city,
          addressRegion: SITE.region,
          addressCountry: "CO",
        },
        alumniOf: [
          { "@type": "CollegeOrUniversity", name: "Universidad EAFIT" },
          { "@type": "CollegeOrUniversity", name: "Universidad Autónoma Latinoamericana (UNAULA)" },
        ],
        hasCredential: [
          {
            "@type": "EducationalOccupationalCredential",
            credentialCategory: "degree",
            name: "Abogada — Universidad EAFIT",
          },
          {
            "@type": "EducationalOccupationalCredential",
            credentialCategory: "postgraduate degree",
            name: "Especialista en Derecho Procesal Penal — UNAULA",
          },
          {
            "@type": "EducationalOccupationalCredential",
            credentialCategory: "postgraduate degree",
            name: "Magíster en Derecho Procesal Penal y Teoría del Delito — UNAULA",
          },
        ],
      },
    }}
  />
</Layout>
