---
import Layout from "@/layouts/Layout.astro";
import { whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";
---

<Layout
  title="Página no encontrada"
  description="La página que buscas no existe o fue movida."
  path="/404"
  noindex
>
  <section class="flex min-h-[70vh] items-center bg-manila-50 py-20">
    <div class="mx-auto max-w-2xl px-5 text-center sm:px-8">
      <h1 class="hero-rise font-display text-4xl font-semibold text-ink-900 sm:text-5xl">
        Página no encontrada <span class="text-manila-700">(404)</span>
      </h1>
      <p class="hero-rise mt-4 text-lg text-manila-700" style="--rise-delay: 90ms">
        La página que buscas no existe o fue movida. Puedes volver al inicio o escribir
        directamente si necesitas orientación.
      </p>
      <div class="hero-rise mt-8 flex flex-col justify-center gap-3 sm:flex-row" style="--rise-delay: 170ms">
        <a href="/" class="btn-gold">
          Volver al inicio
        </a>
        <a
          href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-primary
          class="btn-outline-gold"
        >
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
