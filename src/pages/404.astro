---
import Layout from "@/layouts/Layout.astro";
import { whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";
---

<Layout
  title="Expediente no encontrado"
  description="La página que buscas no existe o fue movida."
  path="/404"
  noindex
>
  <section class="flex min-h-[70vh] items-center bg-ink-950 py-20">
    <div class="mx-auto max-w-2xl px-5 text-center sm:px-8">
      <h1 class="font-display text-4xl font-semibold text-manila-50 sm:text-5xl">
        Expediente no encontrado <span class="text-ink-500">(404)</span>
      </h1>
      <p class="mt-4 text-lg text-ink-300">
        La página que buscas no existe o fue movida. Puedes volver al inicio o escribir
        directamente si necesitas orientación.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-sm bg-sello-600 px-6 py-3.5 font-semibold text-manila-50 no-underline hover:bg-sello-500"
        >
          Volver al inicio
        </a>
        <a
          href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-sm border border-ink-600 px-6 py-3.5 font-medium text-manila-100 no-underline hover:border-manila-300"
        >
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
