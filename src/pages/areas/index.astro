---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import AreaCard from "@/components/AreaCard.astro";
import { AREAS } from "@/lib/site";
---

<Layout
  title="Áreas de práctica"
  description="Defensa penal, representación de víctimas y criminalidad organizada: las tres áreas en las que Daniela Jaramillo Herrera ejerce en Medellín."
  path="/areas"
>
  <PageHero
    folio="02"
    kicker="Áreas de práctica"
    title="Tres frentes, un mismo criterio"
    lead="Cada área se aborda con el mismo estándar: entender a fondo cómo construye la Fiscalía sus casos, para actuar con precisión desde el primer momento."
  />

  <section class="bg-ink-950 py-16 sm:py-24">
    <div class="mx-auto grid max-w-6xl gap-6 px-5 sm:px-8 md:grid-cols-3">
      {AREAS.map((area) => <AreaCard area={area} />)}
    </div>
  </section>
</Layout>
