---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import ProcessDiagram from "@/components/ProcessDiagram.astro";
import FAQ from "@/components/FAQ.astro";
import JsonLd from "@/components/JsonLd.astro";
import juicio from "@/assets/images/daniela-juicio.webp";
import { SITE, whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";

const faqs = [
  {
    question: "Me citaron a la Fiscalía, ¿qué debo hacer primero?",
    answer:
      "No asistas sin asesoría, incluso si la citación parece informal. Contacta a un abogado penalista antes de la fecha citada: lo que declares desde el inicio puede ser usado durante todo el proceso.",
  },
  {
    question: "¿Qué pasa en las primeras horas después de una captura?",
    answer:
      "La Fiscalía tiene un plazo para poner al capturado ante un juez de control de garantías, quien decide si la captura fue legal y si procede formular imputación. Es la ventana donde la defensa técnica tiene mayor impacto inmediato.",
  },
  {
    question: "¿Imputación es lo mismo que condena?",
    answer:
      "No. La imputación es la comunicación formal de los cargos que investiga la Fiscalía; el proceso apenas comienza. La responsabilidad penal solo se define al final, con sentencia.",
  },
  {
    question: "¿Qué es la medida de aseguramiento?",
    answer:
      "Es una decisión del juez, solicitada por la Fiscalía tras la imputación, que puede implicar privación de la libertad durante el proceso u otras restricciones, mientras se resuelve el caso. No es una condena.",
  },
  {
    question: "¿Cuánto puede durar un proceso penal en Colombia?",
    answer:
      "Varía mucho según la complejidad del caso, la cantidad de procesados y la etapa en la que se resuelva (preacuerdo, principio de oportunidad o juicio oral completo). No hay una duración única.",
  },
  {
    question: "¿Qué derechos tengo si soy víctima de un delito?",
    answer:
      "La víctima puede intervenir en el proceso penal, acceder a información relevante del caso, participar en audiencias clave y buscar la reparación integral de los daños ocasionados por el delito.",
  },
];
---

<Layout
  title="Guía del proceso penal en Colombia"
  description="Cómo funciona el proceso penal acusatorio en Colombia: indagación, imputación, acusación y juicio oral, explicado en lenguaje claro por una abogada penalista en Medellín."
  path="/proceso-penal"
>
  <PageHero
    title="Cómo funciona un proceso penal en Colombia"
    lead="Si te citaron, te capturaron, o estás acompañando a alguien que lo vive, esto explica en qué punto del proceso te encuentras y qué significa realmente cada etapa."
    image={juicio}
    imageAlt="Daniela Jaramillo de pie en una sala de audiencias, durante un juicio oral"
    imageAspect="1.44 / 1"
  />

  <section class="bg-manila-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <ProcessDiagram />
    </div>
  </section>

  <section class="bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-semibold text-ink-900">
        Dudas comunes sobre el proceso
      </h2>
      <div class="mt-8">
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <section class="bg-manila-50 py-14 sm:py-16">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
      data-reveal
    >
      <div>
        <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">
          ¿En qué etapa está tu situación?
        </h2>
        <p class="mt-2 max-w-lg text-manila-700">
          Cuéntale a Daniela dónde te encuentras y qué necesitas resolver.
        </p>
      </div>
      <a
        href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
        target="_blank"
        rel="noopener noreferrer"
        data-whatsapp-primary
        class="btn-gold whitespace-nowrap"
      >
        Escribir por WhatsApp
      </a>
    </div>
  </section>

  <JsonLd
    schema={[
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.question,
          acceptedAnswer: { "@type": "Answer", text: f.answer },
        })),
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Inicio", item: SITE.url },
          { "@type": "ListItem", position: 2, name: "Proceso penal", item: `${SITE.url}/proceso-penal` },
        ],
      },
    ]}
  />
</Layout>
