---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import expediente from "@/assets/images/daniela-expediente.webp";
import { getCollection } from "astro:content";

const articles = (await getCollection("articulos", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="Artículos jurídicos"
  description="Análisis en lenguaje claro sobre proceso penal, defensa, víctimas y criminalidad organizada, escrito por Dra. Daniela Jaramillo, abogada penalista en Medellín."
  path="/articulos"
>
  <PageHero
    title="Artículos"
    lead="Explicaciones claras sobre el proceso penal colombiano, escritas desde la experiencia directa, sin tecnicismos innecesarios."
    image={expediente}
    imageAlt="Daniela Jaramillo estudiando un expediente penal"
    imageAspect="2.4 / 1"
    imagePosition="center 42%"
  />

  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      {
        articles.length > 0 ? (
          articles.map((entry) => <ArticleCard entry={entry} />)
        ) : (
          <p class="text-manila-700">Muy pronto, los primeros artículos.</p>
        )
      }
    </div>
  </section>
</Layout>
