---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import defensa from "@/assets/images/daniela-defensa.webp";
import { AREAS, whatsappLink } from "@/lib/site";

// "Cómo empieza" (cierre de página): tres pasos genéricos de cómo arranca el
// trabajo con Daniela, sin precios ni promesas de resultado — copy autorado,
// aprobado por Daniela, igual criterio que `whenToSeek` en site.ts.
const steps = [
  {
    title: "Cuéntale tu situación",
    description:
      "Por WhatsApp o el formulario, cuéntale a Daniela qué está pasando y en qué momento del proceso te encuentras.",
  },
  {
    title: "Análisis del caso",
    description:
      "Daniela revisa la información disponible y evalúa el estado real y las opciones frente a tu situación.",
  },
  {
    title: "Propuesta de estrategia",
    description: "Te presenta el camino a seguir y lo que implica trabajar juntas.",
  },
];
---

<Layout
  title="Servicios de defensa penal"
  description="Defensa y litigio penal, delitos de especial complejidad, asesoría penal estratégica y representación de víctimas: los servicios que ofrece Daniela Jaramillo en Medellín."
  path="/servicios"
>
  <!-- HERO: misma gramática de placa que perfil/contacto/proceso penal
       (marco sello-400 + filete interior sello-300 + shadow-gold,
       hero-rise/hero-settle), en espejo de proceso-penal — texto a la
       izquierda, placa a la derecha en lg. El índice de las cuatro áreas ya
       no vive aquí (quedaba duplicado con el índice fijo de la sección
       siguiente): en su lugar, los dos accesos de contacto, para que la
       página permita actuar desde el primer viewport. -->
  <section class="border-b border-manila-300 bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-16">
        <div class="order-2 lg:order-1">
          <span class="rule-gold rule-draw block w-24" aria-hidden="true"></span>
          <h1
            class="hero-rise mt-6 max-w-xl font-display text-4xl font-semibold leading-[1.08] text-ink-900 sm:text-5xl"
            style="--rise-delay: 90ms"
          >
            Cuatro frentes, un mismo criterio
          </h1>
          <p class="hero-rise mt-5 max-w-xl text-lg leading-relaxed text-manila-700" style="--rise-delay: 170ms">
            Cada área se aborda con el mismo estándar: entender a fondo cómo construye la Fiscalía sus casos, para
            actuar con precisión desde el primer momento.
          </p>

          <div class="hero-rise mt-9 flex flex-wrap items-center gap-x-6 gap-y-3" style="--rise-delay: 250ms">
            <a
              href={whatsappLink(
                "Hola Daniela, necesito orientación sobre un caso penal y quisiera agendar una consulta.",
              )}
              target="_blank"
              rel="noopener noreferrer"
              data-whatsapp-primary
              class="btn-gold whitespace-nowrap"
            >
              Solicitar por WhatsApp
            </a>
            <a href="/contacto" class="btn-outline-gold whitespace-nowrap">
              Formulario de contacto
            </a>
          </div>
        </div>

        <div class="hero-rise relative order-1 mx-auto w-full max-w-xs lg:order-2 lg:mx-0 lg:max-w-none" style="--rise-delay: 130ms">
          <div class="hero-settle relative border border-sello-400 bg-manila-50 p-3 shadow-gold sm:p-4">
            <div class="border border-sello-300 p-1">
              <Picture
                src={defensa}
                alt="Daniela Jaramillo, abogada penalista en Medellín, en su escritorio"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[420, 560, 720, 960]}
                sizes="(min-width: 1024px) 38vw, (min-width: 640px) 58vw, 82vw"
                class="w-full object-cover"
                style="aspect-ratio: 4 / 5; object-position: center 20%;"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS: índice fijo + fichas. En lg+, columna izquierda sticky
       (`top-28`, misma cota que `scroll-mt-28` ya usado en el sitio para
       compensar el header sticky) con los 4 servicios — única navegación
       de la página — y el activo marcado en oro por el scrollspy más abajo.
       En md y menor, ese mismo <nav> se convierte en una barra horizontal
       sticky bajo el header (negative margin al ancho del contenedor).
       Cada ficha lleva el texto literal de la clienta (numeral + título +
       descripción, intactos) más "Cuándo acudir" (borrador, ver frontmatter
       de site.ts) y los dos accesos de contacto — el CTA que faltaba. -->
  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="lg:grid lg:grid-cols-12 lg:gap-x-12">
        <nav
          aria-label="Servicios"
          class="sticky top-16 z-30 -mx-5 mb-10 border-b border-manila-300 bg-manila-50/95 px-5 py-1 backdrop-blur-sm sm:-mx-8 sm:px-8 lg:sticky lg:top-28 lg:col-span-3 lg:mx-0 lg:mb-0 lg:self-start lg:border-b-0 lg:bg-transparent lg:px-0 lg:py-0 lg:backdrop-blur-none"
        >
          <ol class="flex gap-2 overflow-x-auto lg:flex-col lg:gap-0 lg:overflow-visible">
            {
              AREAS.map((area, i) => (
                <li class="shrink-0 lg:shrink lg:border-t lg:border-manila-300 lg:first:border-t-0">
                  <a
                    href={`#area-${area.slug}`}
                    data-index-link
                    data-target={`area-${area.slug}`}
                    class:list={["index-link", i === 0 && "is-active"]}
                  >
                    <span class="index-num folio-kicker whitespace-nowrap">{String(i + 1).padStart(2, "0")}</span>
                    <span class="index-title whitespace-nowrap font-display text-sm font-semibold lg:whitespace-normal lg:text-base">
                      {area.title}
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="divide-y divide-manila-300 lg:col-span-9">
          {
            AREAS.map((area, i) => (
              <article
                id={`area-${area.slug}`}
                data-service-section
                class="scroll-mt-32 py-12 first:pt-0 sm:py-16"
                data-reveal
                style={`--reveal-delay: ${Math.min(i, 2) * 90}ms`}
              >
                <div class="flex items-start gap-6 sm:gap-8">
                  <span
                    class="hidden shrink-0 font-display text-6xl font-medium leading-none text-sello-700 sm:block sm:text-7xl"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div class="min-w-0 flex-1">
                    <span class="folio-kicker text-sello-700 sm:hidden">{String(i + 1).padStart(2, "0")}</span>
                    <h2 class="mt-1 font-display text-2xl font-semibold leading-snug text-ink-900 sm:mt-0 sm:text-3xl">
                      {area.title}
                    </h2>
                    <p class="mt-4 max-w-[62ch] text-base leading-relaxed text-manila-700 sm:text-lg">
                      {area.description}
                    </p>

                    <div class="mt-7 max-w-[62ch] border-t border-manila-300 pt-6">
                      <p class="block-label text-sello-700">Cuándo acudir</p>
                      <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-manila-700 sm:text-base">
                        {area.whenToSeek.map((item) => (
                          <li class="flex gap-2.5">
                            <span class="mt-[0.55em] h-1 w-1 shrink-0 rounded-full bg-sello-500" aria-hidden="true" />
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
                      <a
                        href={whatsappLink(
                          `Hola Daniela, quiero información sobre ${area.title.toLowerCase()}. Me gustaría agendar una consulta.`,
                        )}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-whatsapp-primary
                        class="btn-gold whitespace-nowrap !px-6 !py-3 !text-[0.7rem]"
                      >
                        Solicitar por WhatsApp
                      </a>
                      <a
                        href={`/contacto?area=${area.slug}`}
                        class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em] text-sello-700 no-underline hover:text-sello-600"
                      >
                        Ir al formulario
                        <span aria-hidden="true">→</span>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CÓMO EMPIEZA: cierre de página — tres pasos (borrador, ver
       frontmatter) + el mismo CTA final de doble acceso que usa el resto
       del sitio (WhatsApp directo / formulario), para no dejar la página
       sin una llamada a la acción de cierre además de las de cada ficha. -->
  <section class="border-t border-manila-300 bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="max-w-xl" data-reveal>
        <p class="block-label text-sello-700">Cómo empieza</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
          Tres pasos para empezar a trabajar juntas
        </h2>
      </div>

      <ol class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-3" data-stagger>
        {
          steps.map((step, i) => (
            <li>
              <span class="folio-kicker text-sello-700">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-3 font-display text-xl font-semibold text-ink-900">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-manila-700 sm:text-base">{step.description}</p>
            </li>
          ))
        }
      </ol>

      <div
        class="mt-12 flex flex-col gap-6 border-t border-manila-300 pt-8 sm:flex-row sm:items-center sm:justify-between"
        data-reveal
      >
        <p class="max-w-md text-manila-700">Cuéntale a Daniela tu situación y con qué servicio se relaciona.</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a
            href={whatsappLink(
              "Hola Daniela, necesito orientación sobre un caso penal y quisiera agendar una consulta.",
            )}
            target="_blank"
            rel="noopener noreferrer"
            data-whatsapp-primary
            class="btn-gold whitespace-nowrap"
          >
            WhatsApp directo
          </a>
          <a href="/contacto" class="btn-outline-gold whitespace-nowrap">
            Formulario de contacto
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Scrollspy del índice fijo: mejora progresiva — sin IntersectionObserver
    // los enlaces siguen funcionando como anclas normales, solo sin el
    // marcador de "estás aquí". Banda de detección angosta cerca del tope
    // del viewport (técnica estándar de scrollspy), no el viewport completo,
    // para que el servicio activo cambie cuando su ficha realmente lidera
    // la lectura.
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-index-link]");
    const sections = document.querySelectorAll<HTMLElement>("[data-service-section]");

    if (links.length && sections.length && "IntersectionObserver" in window) {
      const setActive = (id: string) => {
        links.forEach((link) => link.classList.toggle("is-active", link.dataset.target === id));
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting);
          if (!visible.length) return;
          const top = visible.reduce((a, b) =>
            a.boundingClientRect.top < b.boundingClientRect.top ? a : b,
          );
          setActive(top.target.id);
        },
        { rootMargin: "-15% 0px -70% 0px" },
      );

      sections.forEach((section) => observer.observe(section));
    }
  </script>
</Layout>
