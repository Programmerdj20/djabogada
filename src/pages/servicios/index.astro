---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import defensa from "@/assets/images/daniela-defensa.webp";
import { AREAS, whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";
---

<Layout
  title="Servicios de defensa penal"
  description="Defensa y litigio penal, delitos de especial complejidad, asesoría penal estratégica y representación de víctimas: los servicios que ofrece Daniela Jaramillo en Medellín."
  path="/servicios"
>
  <!-- HERO: misma gramática de placa que perfil/contacto/proceso penal
       (marco sello-400 + filete interior sello-300 + shadow-gold,
       hero-rise/hero-settle), en espejo de proceso-penal — placa a la
       derecha en lg. Sin H1, sin párrafo y sin botones: el hero es
       únicamente el índice de las cuatro áreas (movido aquí desde la
       sección de fichas, que se quedaba sin él para no duplicarlo). Cada
       enlace es también el H1 funcional de la página vía el H2 con las
       mismas anclas más abajo. -->
  <section class="border-b border-manila-300 bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-16">
        <div class="order-2 lg:order-1">
          <span class="rule-gold rule-draw block w-24" aria-hidden="true"></span>
          <h1 class="sr-only">Servicios de defensa penal de Daniela Jaramillo</h1>
          <nav aria-label="Áreas de servicio" class="hero-rise mt-8 max-w-md lg:mt-10 lg:max-w-lg" style="--rise-delay: 90ms">
            <ol>
              {
                AREAS.map((area, i) => (
                  <li class="border-t border-manila-300 first:border-t-0">
                    <a
                      href={`#area-${area.slug}`}
                      data-index-link
                      data-target={`area-${area.slug}`}
                      class:list={["index-link", "lg:gap-4 lg:py-4 lg:pl-5", i === 0 && "is-active"]}
                    >
                      <span class="index-num folio-kicker lg:text-sm">{String(i + 1).padStart(2, "0")}</span>
                      <span class="index-title font-display text-lg font-semibold sm:text-xl lg:text-2xl">
                        {area.title}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </div>

        <div class="hero-rise relative order-1 mx-auto w-full max-w-xs lg:order-2 lg:mx-0 lg:max-w-none" style="--rise-delay: 130ms">
          <div class="hero-settle relative border border-sello-400 bg-manila-50 p-3 shadow-gold sm:p-4">
            <div class="border border-sello-300 p-1">
              <Picture
                src={defensa}
                alt="Daniela Jaramillo, abogada penalista en Medellín, en su escritorio"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[420, 560, 720, 960]}
                sizes="(min-width: 1024px) 38vw, (min-width: 640px) 58vw, 82vw"
                class="w-full object-cover"
                style="aspect-ratio: 4 / 5; object-position: center 20%;"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS: solo fichas — el índice ya no vive aquí, se movió al hero
       para no duplicarlo. El activo se sigue marcando en oro por el
       scrollspy más abajo (mejora progresiva sobre el índice del hero).
       Cada ficha lleva el texto literal de la clienta (numeral + título +
       descripción, intactos). -->
  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <div class="divide-y divide-manila-300">
        {
          AREAS.map((area, i) => (
            <article
              id={`area-${area.slug}`}
              data-service-section
              class="scroll-mt-32 py-12 first:pt-0 sm:py-16"
              data-reveal
              style={`--reveal-delay: ${Math.min(i, 2) * 90}ms`}
            >
              <div class="flex items-start gap-6 sm:gap-8">
                <span
                  class="hidden shrink-0 font-display text-6xl font-medium leading-none text-sello-700 sm:block sm:text-7xl"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="min-w-0 flex-1">
                  <span class="folio-kicker text-sello-700 sm:hidden">{String(i + 1).padStart(2, "0")}</span>
                  <h2 class="mt-1 font-display text-2xl font-semibold leading-snug text-ink-900 sm:mt-0 sm:text-3xl">
                    {area.title}
                  </h2>
                  <p class="mt-4 max-w-[62ch] text-base leading-relaxed text-manila-700 sm:text-lg">
                    {area.description}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA FINAL: mismo bloque compacto de una línea + doble acceso de
       contacto que usa /perfil como cierre — reemplaza el bloque de tres
       pasos "Cómo empieza" que llevaba antes. -->
  <section class="bg-manila-100 py-16 sm:py-20">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
      data-reveal
    >
      <div>
        <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">
          Cuéntame tu caso
        </h2>
        <p class="mt-2 max-w-lg text-manila-700">
          Cuanto antes tenga claridad sobre tu situación, más opciones reales podremos evaluar.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-primary
          class="btn-gold whitespace-nowrap"
        >
          WhatsApp directo
        </a>
        <a href="/contacto" class="btn-outline-gold whitespace-nowrap">
          Formulario de contacto
        </a>
      </div>
    </div>
  </section>

  <script>
    // Scrollspy del índice fijo: mejora progresiva — sin IntersectionObserver
    // los enlaces siguen funcionando como anclas normales, solo sin el
    // marcador de "estás aquí". Banda de detección angosta cerca del tope
    // del viewport (técnica estándar de scrollspy), no el viewport completo,
    // para que el servicio activo cambie cuando su ficha realmente lidera
    // la lectura.
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-index-link]");
    const sections = document.querySelectorAll<HTMLElement>("[data-service-section]");

    if (links.length && sections.length && "IntersectionObserver" in window) {
      const setActive = (id: string) => {
        links.forEach((link) => link.classList.toggle("is-active", link.dataset.target === id));
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting);
          if (!visible.length) return;
          const top = visible.reduce((a, b) =>
            a.boundingClientRect.top < b.boundingClientRect.top ? a : b,
          );
          setActive(top.target.id);
        },
        { rootMargin: "-15% 0px -70% 0px" },
      );

      sections.forEach((section) => observer.observe(section));
    }
  </script>
</Layout>
