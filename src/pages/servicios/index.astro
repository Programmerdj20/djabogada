---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import AreaCard from "@/components/AreaCard.astro";
import expediente from "@/assets/images/daniela-expediente.webp";
import { AREAS } from "@/lib/site";
---

<Layout
  title="Servicios de defensa penal"
  description="Defensa y litigio penal, delitos de especial complejidad, asesoría penal estratégica y representación de víctimas: los servicios que ofrece Daniela Jaramillo en Medellín."
  path="/servicios"
>
  <PageHero
    title="Cuatro frentes, un mismo criterio"
    lead="Cada área se aborda con el mismo estándar: entender a fondo cómo construye la Fiscalía sus casos, para actuar con precisión desde el primer momento."
    image={expediente}
    imageAlt="Daniela Jaramillo analizando un expediente penal"
    imageAspect="2.4 / 1"
    imagePosition="center 42%"
  />

  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto grid max-w-6xl gap-6 px-5 sm:px-8 md:grid-cols-2 lg:grid-cols-4">
      {AREAS.map((area, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 90}ms`}>
          <AreaCard area={area} />
        </div>
      ))}
    </div>
  </section>
</Layout>
