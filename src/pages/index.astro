---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import AreaCard from "@/components/AreaCard.astro";
import ProcessDiagram from "@/components/ProcessDiagram.astro";
import FAQ from "@/components/FAQ.astro";
import JsonLd from "@/components/JsonLd.astro";
import heroPortrait from "@/assets/images/daniela-hero.webp";
import heroPlate from "@/assets/images/daniela-hero-plate.webp";
import expediente from "@/assets/images/daniela-expediente.webp";
import { AREAS, SITE, whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";

// Copy de tesis del hero: la asimetría (construyó acusaciones, hoy defiende)
// convertida en beneficio directo, sin sonar como adversaria de la Fiscalía
// —Daniela tiene una nominación a Fiscal pendiente— y sin usar el cargo que
// no tuvo (fue Asistente de Fiscal I y IV, nunca fiscal). Nunca promete un
// resultado ("ganamos tu caso"): las normas de publicidad para abogados en
// Colombia lo restringen, y tampoco sería honesto.
const heroHeadline = "Conozco por dentro cómo se construye una acusación. Por eso sé cómo defenderte.";
const heroLead =
  "Ocho años en la Fiscalía General de la Nación, en la unidad especializada contra el crimen organizado, me dieron el criterio con el que se evalúa la evidencia y se decide una imputación. Hoy pongo ese conocimiento al servicio de tu defensa.";

const faqs = [
  {
    question: "Me citaron a versión libre o indagatoria en la Fiscalía, ¿qué debo hacer?",
    answer:
      "Antes de asistir a cualquier diligencia, busca asesoría. Lo que digas desde el primer momento puede definir el rumbo del proceso. Escríbeme antes de la citación, no después.",
  },
  {
    question: "¿Puedo contratar defensa si ya fui capturado?",
    answer:
      "Sí. Es precisamente el momento donde la defensa técnica es más urgente: dentro de las 36 horas siguientes a la captura se define la legalización y la posible medida de aseguramiento.",
  },
  {
    question: "¿Atienden casos de víctimas o solo de defensa?",
    answer:
      "Ambos. Represento tanto a personas investigadas o procesadas como a víctimas y sus familias que buscan constituirse dentro de un proceso penal en curso.",
  },
  {
    question: "¿Por qué su experiencia en la Fiscalía hace diferencia en mi defensa?",
    answer:
      "Porque durante ocho años estuvo del otro lado: redactando escritos de acusación, evaluando preacuerdos y coordinando con policía judicial. Conoce el criterio con el que se construye un caso, no solo el que se usa para defenderlo.",
  },
];
---

<Layout
  title="Abogada Penalista en Medellín — Defensa, Víctimas y Criminalidad Organizada"
  description="Dra. Daniela Jaramillo, abogada penalista en Medellín. Ocho años en la Fiscalía General de la Nación, unidad contra el crimen organizado. Defensa penal, representación de víctimas y delitos complejos."
  path="/"
>
  <!-- HERO -->
  {/* Dos composiciones distintas por viewport, no una sola reescalada.
      Móvil (< lg): la foto original a pantalla completa con el texto abajo
      sobre un velo marfil — la versión que ya quedó aprobada, sin tocar su
      fotografía ni su velo, solo se le añade el copy de tesis.
      Desktop (lg+): un retrato recortado on-device falló el control de
      calidad (quedaba un resto gris de la silla, ver nota de decisión más
      abajo), así que se usa la "placa de retrato": la foto completa, en
      color corregido más cálido (`daniela-hero-plate.webp`, la pared gris
      de oficina pasa a leerse marfil), dentro de una placa de canto nítido
      con un filete de oro desplazado detrás — un passe-partout — en vez del
      bloque a sangre con degradado gris de la versión anterior. El titular
      grande cruza apenas el filete desplazado. */}
  <section class="relative border-b border-manila-300 bg-manila-50">
    {/* ── Móvil / tablet: foto a pantalla completa (sin cambios) ── */}
    <div class="relative h-[calc(100svh-4rem)] min-h-[38rem] overflow-hidden lg:hidden">
      <div class="hero-drift absolute inset-0">
        <Picture
          src={heroPortrait}
          alt={`${SITE.name}, abogada penalista en Medellín, en su oficina`}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[480, 640, 900]}
          sizes="100vw"
          class="hero-settle h-full w-full object-cover object-[center_18%]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-[62%] bg-gradient-to-t from-manila-50 via-manila-50/80 to-transparent md:h-[78%]"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sello-400 to-transparent"
        aria-hidden="true"
      ></div>

      <div class="relative flex h-full items-end pb-10">
        <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
          <span class="rule-gold rule-draw block w-16" aria-hidden="true" style="--rise-delay: 0ms"></span>

          <h1 class="hero-rise mt-5 font-display font-semibold text-ink-900" style="--rise-delay: 90ms">
            <span class="block text-[2rem] uppercase leading-[1.05] tracking-[0.01em] sm:text-4xl">
              Daniela Jaramillo
            </span>
            <span class="sr-only">, </span>
            <span class="mt-2 flex items-center gap-2.5">
              <span class="h-3.5 w-px shrink-0 bg-sello-400" aria-hidden="true"></span>
              <span class="font-sans text-xs font-semibold uppercase tracking-[0.28em] text-sello-700 sm:text-sm">
                Abogada penalista en Medellín
              </span>
            </span>
          </h1>

          <p
            class="hero-rise mt-4 max-w-md font-display text-[1.5rem] font-semibold leading-[1.18] text-ink-900 sm:text-[1.75rem]"
            style="--rise-delay: 170ms"
          >
            {heroHeadline}
          </p>

          <p
            class="hero-rise mt-3 hidden max-w-md text-[0.9rem] leading-relaxed text-manila-700 sm:text-base md:block"
            style="--rise-delay: 230ms"
          >
            {heroLead}
          </p>

          <div class="hero-rise mt-6 flex gap-3" style="--rise-delay: 300ms">
            <a href="/contacto" class="btn-gold flex-1 !px-4 whitespace-nowrap">
              Agenda tu consulta
            </a>
            <a
              href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
              target="_blank"
              rel="noopener noreferrer"
              data-whatsapp-primary
              class="btn-outline-gold !px-4 whitespace-nowrap"
            >
              WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* ── Desktop: placa de retrato ── */}
    <div class="hidden lg:block">
      <div class="mx-auto max-w-6xl px-8 py-20 xl:py-24">
        <div class="grid grid-cols-[1.15fr_0.85fr] items-center gap-10 xl:gap-14">
          <div class="relative z-10 max-w-xl">
            <span class="rule-gold rule-draw block w-20" aria-hidden="true" style="--rise-delay: 0ms"></span>

            <h1 class="hero-rise mt-6 font-display font-semibold text-ink-900" style="--rise-delay: 90ms">
              <span class="block text-[1.85rem] uppercase leading-[1.05] tracking-[0.01em] xl:text-[2.1rem]">
                Daniela Jaramillo
              </span>
              <span class="sr-only">, </span>
              <span class="mt-3 flex items-center gap-3">
                <span class="h-4 w-px shrink-0 bg-sello-400" aria-hidden="true"></span>
                <span class="font-sans text-sm font-semibold uppercase tracking-[0.28em] text-sello-700">
                  Abogada penalista en Medellín
                </span>
              </span>
            </h1>

            <p
              class="hero-rise -mr-6 mt-6 font-display text-[2.35rem] font-semibold leading-[1.1] text-ink-900 xl:text-[2.75rem]"
              style="--rise-delay: 170ms"
            >
              {heroHeadline}
            </p>

            <p class="hero-rise mt-6 max-w-md text-[1.0625rem] leading-relaxed text-manila-700" style="--rise-delay: 230ms">
              {heroLead}
            </p>

            <div class="hero-rise mt-9 flex items-center gap-4" style="--rise-delay: 300ms">
              <a href="/contacto" class="btn-gold whitespace-nowrap">
                Agenda tu consulta
              </a>
              <a
                href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
                target="_blank"
                rel="noopener noreferrer"
                data-whatsapp-primary
                class="btn-outline-gold whitespace-nowrap"
              >
                Escribir por WhatsApp
              </a>
            </div>
          </div>

          {/* La placa: canto nítido, sin degradado. El filete desplazado
              detrás (passe-partout) es el único motivo decorativo; el
              titular la cruza apenas gracias al -mr-6 de arriba. */}
          <div class="hero-rise relative" style="--rise-delay: 130ms">
            <div class="absolute -left-5 -top-5 h-full w-full border border-sello-400" aria-hidden="true"></div>
            <div class="hero-settle relative aspect-[2/3] overflow-hidden border border-ink-900/10 bg-manila-100 shadow-panel">
              <Picture
                src={heroPlate}
                alt={`${SITE.name}, abogada penalista en Medellín, en su oficina`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[480, 640, 760]}
                sizes="(min-width: 1280px) 34vw, 38vw"
                class="h-full w-full object-cover object-[42%_16%]"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LA ASIMETRÍA: CONSTRUYÓ ACUSACIONES, HOY LAS ENFRENTA -->
  <section class="bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div data-reveal>
          <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
            Antes de defender, acusó
          </h2>
        </div>
        <div class="prose-editorial" data-reveal style="--reveal-delay: 80ms">
          <p>
            Durante ocho años trabajó como asistente de fiscal en la <strong>Dirección
            Especializada Contra las Organizaciones Criminales (DECOC)</strong> de la Fiscalía
            General de la Nación en Medellín: proyectó escritos de acusación, evaluó preacuerdos,
            acompañó audiencias e interrogatorios, y gestionó el sistema misional que hoy sigue
            usando la Fiscalía en cada investigación.
          </p>
          <p>
            Eso significa algo muy concreto para quien hoy enfrenta un proceso penal: conoce el
            criterio real con el que se evalúa la evidencia, se negocia un preacuerdo o se decide
            imputar. No es una lectura de manual — es la experiencia de haber estado, literalmente,
            del otro lado del proceso.
          </p>
        </div>
      </div>

      <div
        class="mt-14 border border-sello-400 bg-manila-50 p-3 shadow-gold sm:p-4"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        <div class="border border-sello-300 p-1">
          <Picture
            src={expediente}
            alt="Daniela Jaramillo estudiando un expediente penal en su escritorio"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1152px) 1088px, 92vw"
            class="w-full object-cover object-[center_42%]"
            style="aspect-ratio: 2.4 / 1;"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <dl
        class="mt-16 grid gap-10 border-t border-sello-400 pt-10 sm:grid-cols-3 sm:gap-8 sm:divide-x sm:divide-manila-300"
        data-reveal
        style="--reveal-delay: 140ms"
      >
        <div class="sm:pr-8">
          <dt class="folio-kicker text-sello-600">2018 — 2026</dt>
          <dd class="mt-2 font-display text-lg font-semibold text-ink-900">
            Ocho años en la Fiscalía General de la Nación
          </dd>
        </div>
        <div class="sm:px-8">
          <dt class="folio-kicker text-sello-600">DECOC</dt>
          <dd class="mt-2 font-display text-lg font-semibold text-ink-900">
            Unidad especializada contra organizaciones criminales
          </dd>
        </div>
        <div class="sm:pl-8">
          <dt class="folio-kicker text-sello-600">UNAULA</dt>
          <dd class="mt-2 font-display text-lg font-semibold text-ink-900">
            Magíster y Especialista en Derecho Procesal Penal
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ÁREAS DE PRÁCTICA -->
  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
            Áreas de práctica
          </h2>
        </div>
        <a href="/areas" class="text-xs font-semibold uppercase tracking-[0.1em] text-sello-700 no-underline hover:text-sello-600">
          Ver todas las áreas →
        </a>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {AREAS.map((area, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <AreaCard area={area} compact />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESO PENAL -->
  <section class="bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="max-w-2xl" data-reveal>
        <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
          ¿Cómo funciona un proceso penal en Colombia?
        </h2>
        <p class="prose-editorial mt-4">
          Si te citaron, te capturaron o estás acompañando a alguien que lo vive, lo primero es
          entender en qué punto del proceso te encuentras.
        </p>
      </div>

      <div class="mt-10" data-reveal style="--reveal-delay: 100ms">
        <ProcessDiagram />
      </div>

      <a
        href="/proceso-penal"
        class="mt-8 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em] text-sello-700 no-underline hover:text-sello-600"
      >
        Ver la guía completa del proceso penal →
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl" data-reveal>
        Antes de escribir
      </h2>
      <div class="mt-8" data-reveal style="--reveal-delay: 100ms">
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-manila-100 py-16 sm:py-20">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
      data-reveal
    >
      <div>
        <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">
          ¿Necesitas orientación ahora mismo?
        </h2>
        <p class="mt-2 max-w-lg text-manila-700">
          Cuanto antes hables con tu defensa, más opciones reales tienes. Escribe y cuéntale a
          Daniela tu situación.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-primary
          class="btn-gold whitespace-nowrap"
        >
          WhatsApp directo
        </a>
        <a href="/contacto" class="btn-outline-gold whitespace-nowrap">
          Formulario de contacto
        </a>
      </div>
    </div>
  </section>

  <JsonLd
    schema={{
      "@context": "https://schema.org",
      "@type": "Attorney",
      name: SITE.name,
      url: SITE.url,
      image: `${SITE.url}/og/default.png`,
      telephone: SITE.phoneE164,
      email: SITE.email,
      areaServed: {
        "@type": "City",
        name: SITE.city,
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: SITE.city,
        addressRegion: SITE.region,
        addressCountry: "CO",
      },
      knowsAbout: AREAS.map((a) => a.title),
      hasCredential: [
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "degree",
          name: "Abogada — Universidad EAFIT",
        },
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "postgraduate degree",
          name: "Especialista en Derecho Procesal Penal — UNAULA",
        },
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "postgraduate degree",
          name: "Magíster en Derecho Procesal Penal y Teoría del Delito — UNAULA",
        },
      ],
    }}
  />
</Layout>
