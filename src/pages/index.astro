---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import AreaCard from "@/components/AreaCard.astro";
import ProcessDiagram from "@/components/ProcessDiagram.astro";
import FAQ from "@/components/FAQ.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import JsonLd from "@/components/JsonLd.astro";
import escritorio from "@/assets/images/daniela-escritorio.webp";
import expediente from "@/assets/images/daniela-expediente.webp";
import { AREAS, SITE, whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";

const articles = (await getCollection("articulos", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const faqs = [
  {
    question: "Me citaron a versión libre o indagatoria en la Fiscalía, ¿qué debo hacer?",
    answer:
      "Antes de asistir a cualquier diligencia, busca asesoría. Lo que digas desde el primer momento puede definir el rumbo del proceso. Escríbeme antes de la citación, no después.",
  },
  {
    question: "¿Puedo contratar defensa si ya fui capturado?",
    answer:
      "Sí. Es precisamente el momento donde la defensa técnica es más urgente: dentro de las 36 horas siguientes a la captura se define la legalización y la posible medida de aseguramiento.",
  },
  {
    question: "¿Atienden casos de víctimas o solo de defensa?",
    answer:
      "Ambos. Represento tanto a personas investigadas o procesadas como a víctimas y sus familias que buscan constituirse dentro de un proceso penal en curso.",
  },
  {
    question: "¿Por qué su experiencia en la Fiscalía hace diferencia en mi defensa?",
    answer:
      "Porque durante ocho años estuvo del otro lado: redactando escritos de acusación, evaluando preacuerdos y coordinando con policía judicial. Conoce el criterio con el que se construye un caso, no solo el que se usa para defenderlo.",
  },
];
---

<Layout
  title="Abogada Penalista en Medellín — Defensa, Víctimas y Criminalidad Organizada"
  description="Dra. Daniela Jaramillo, abogada penalista en Medellín. Ocho años en la Fiscalía General de la Nación, unidad contra el crimen organizado. Defensa penal, representación de víctimas y delitos complejos."
  path="/"
>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden border-b border-manila-300 bg-manila-50">
    <div class="relative">
      {/* La fotografía entra completa, a su proporción natural: el alto del
          contenedor es el alto real de la imagen, así que nunca se recorta.
          `hero-drift` da una deriva apenas perceptible; `hero-settle` la
          asienta al cargar. Ambas se desactivan con prefers-reduced-motion. */}
      <div class="hero-drift lg:min-h-[34rem]">
        <Picture
          src={escritorio}
          alt={`${SITE.name}, abogada penalista en Medellín, en su escritorio con libros jurídicos`}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="100vw"
          class="hero-settle block h-auto w-full"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      {/* Velo marfil solo donde va el texto (escritorio). En móvil el texto
          vive debajo de la imagen, sobre el marfil del sitio. */}
      <div
        class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-manila-50 via-manila-50/92 to-manila-50/0 lg:block"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sello-400 to-transparent"
        aria-hidden="true"
      ></div>

      {/* Texto: bajo la imagen hasta lg; superpuesto y centrado desde lg. */}
      <div class="relative lg:absolute lg:inset-0 lg:flex lg:items-center">
        <div class="mx-auto w-full max-w-6xl px-5 py-10 sm:px-8 sm:py-14 lg:py-0">
          <div class="max-w-xl">
            <span class="rule-gold rule-draw block w-20" aria-hidden="true" style="--rise-delay: 0ms"></span>

            <h1
              class="hero-rise mt-7 font-display text-[2.75rem] font-semibold leading-[1.04] text-ink-900 sm:text-6xl lg:text-6xl xl:text-[4.25rem]"
              style="--rise-delay: 90ms"
            >
              {SITE.name}
            </h1>

            <p class="hero-rise mt-4 text-lg font-medium tracking-wide text-sello-700 sm:text-xl" style="--rise-delay: 170ms">
              Abogada penalista en Medellín
            </p>

            <p class="hero-rise mt-6 max-w-xl text-base leading-relaxed text-manila-700 sm:text-lg" style="--rise-delay: 250ms">
              Durante ocho años construyó el caso de la Fiscalía General de la Nación en la unidad
              contra el crimen organizado de Medellín. Hoy pone ese mismo criterio, al más alto
              nivel, al servicio de tu defensa.
            </p>

            <div class="hero-rise mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" style="--rise-delay: 330ms">
              <a href="/contacto" class="btn-gold">
                Agenda tu consulta
              </a>
              <a
                href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
                target="_blank"
                rel="noopener noreferrer"
                data-whatsapp-primary
                class="btn-outline-gold"
              >
                Escribir por WhatsApp
              </a>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LA ASIMETRÍA: CONSTRUYÓ ACUSACIONES, HOY LAS ENFRENTA -->
  <section class="bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div data-reveal>
          <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
            Antes de defender, acusó
          </h2>
        </div>
        <div class="prose-editorial" data-reveal style="--reveal-delay: 80ms">
          <p>
            Durante ocho años trabajó como asistente de fiscal en la <strong>Dirección
            Especializada Contra las Organizaciones Criminales (DECOC)</strong> de la Fiscalía
            General de la Nación en Medellín: proyectó escritos de acusación, evaluó preacuerdos,
            acompañó audiencias e interrogatorios, y gestionó el sistema misional que hoy sigue
            usando la Fiscalía en cada investigación.
          </p>
          <p>
            Eso significa algo muy concreto para quien hoy enfrenta un proceso penal: conoce el
            criterio real con el que se evalúa la evidencia, se negocia un preacuerdo o se decide
            imputar. No es una lectura de manual — es la experiencia de haber estado, literalmente,
            del otro lado del proceso.
          </p>
        </div>
      </div>

      <div
        class="mt-14 border border-sello-400 bg-manila-50 p-3 shadow-gold sm:p-4"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        <div class="border border-sello-300 p-1">
          <Picture
            src={expediente}
            alt="Daniela Jaramillo estudiando un expediente penal en su escritorio"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1152px) 1088px, 92vw"
            class="w-full object-cover object-[center_42%]"
            style="aspect-ratio: 2.4 / 1;"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <dl
        class="mt-16 grid gap-10 border-t border-sello-400 pt-10 sm:grid-cols-3 sm:gap-8 sm:divide-x sm:divide-manila-300"
        data-reveal
        style="--reveal-delay: 140ms"
      >
        <div class="sm:pr-8">
          <dt class="folio-kicker text-sello-600">2018 — 2026</dt>
          <dd class="mt-2 font-display text-lg font-semibold text-ink-900">
            Ocho años en la Fiscalía General de la Nación
          </dd>
        </div>
        <div class="sm:px-8">
          <dt class="folio-kicker text-sello-600">DECOC</dt>
          <dd class="mt-2 font-display text-lg font-semibold text-ink-900">
            Unidad especializada contra organizaciones criminales
          </dd>
        </div>
        <div class="sm:pl-8">
          <dt class="folio-kicker text-sello-600">UNAULA</dt>
          <dd class="mt-2 font-display text-lg font-semibold text-ink-900">
            Magíster y Especialista en Derecho Procesal Penal
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ÁREAS DE PRÁCTICA -->
  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
            Áreas de práctica
          </h2>
        </div>
        <a href="/areas" class="text-xs font-semibold uppercase tracking-[0.1em] text-sello-700 no-underline hover:text-sello-600">
          Ver todas las áreas →
        </a>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {AREAS.map((area, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <AreaCard area={area} compact />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESO PENAL -->
  <section class="bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="max-w-2xl" data-reveal>
        <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
          ¿Cómo funciona un proceso penal en Colombia?
        </h2>
        <p class="prose-editorial mt-4">
          Si te citaron, te capturaron o estás acompañando a alguien que lo vive, lo primero es
          entender en qué punto del proceso te encuentras.
        </p>
      </div>

      <div class="mt-10" data-reveal style="--reveal-delay: 100ms">
        <ProcessDiagram />
      </div>

      <a
        href="/proceso-penal"
        class="mt-8 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em] text-sello-700 no-underline hover:text-sello-600"
      >
        Ver la guía completa del proceso penal →
      </a>
    </div>
  </section>

  <!-- ARTÍCULOS -->
  {
    articles.length > 0 && (
      <section class="bg-manila-50 py-16 sm:py-24">
        <div class="mx-auto max-w-6xl px-5 sm:px-8">
          <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
            <div>
              <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
                Últimos artículos
              </h2>
            </div>
            <a href="/articulos" class="text-xs font-semibold uppercase tracking-[0.1em] text-sello-700 no-underline hover:text-sello-600">
              Ver todos →
            </a>
          </div>
          <div class="mt-8 max-w-3xl" data-reveal data-stagger style="--reveal-delay: 100ms">
            {articles.map((entry) => <ArticleCard entry={entry} />)}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl" data-reveal>
        Antes de escribir
      </h2>
      <div class="mt-8" data-reveal style="--reveal-delay: 100ms">
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-manila-50 py-16 sm:py-20">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
      data-reveal
    >
      <div>
        <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">
          ¿Necesitas orientación ahora mismo?
        </h2>
        <p class="mt-2 max-w-lg text-manila-700">
          Cuanto antes hables con tu defensa, más opciones reales tienes. Escribe y cuéntale a
          Daniela tu situación.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-primary
          class="btn-gold whitespace-nowrap"
        >
          WhatsApp directo
        </a>
        <a href="/contacto" class="btn-outline-gold whitespace-nowrap">
          Formulario de contacto
        </a>
      </div>
    </div>
  </section>

  <JsonLd
    schema={{
      "@context": "https://schema.org",
      "@type": "Attorney",
      name: SITE.name,
      url: SITE.url,
      image: `${SITE.url}/og/default.png`,
      telephone: SITE.phoneE164,
      email: SITE.email,
      areaServed: {
        "@type": "City",
        name: SITE.city,
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: SITE.city,
        addressRegion: SITE.region,
        addressCountry: "CO",
      },
      knowsAbout: AREAS.map((a) => a.title),
      hasCredential: [
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "degree",
          name: "Abogada — Universidad EAFIT",
        },
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "postgraduate degree",
          name: "Especialista en Derecho Procesal Penal — UNAULA",
        },
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "postgraduate degree",
          name: "Magíster en Derecho Procesal Penal y Teoría del Delito — UNAULA",
        },
      ],
    }}
  />
</Layout>
