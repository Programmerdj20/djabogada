---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import JsonLd from "@/components/JsonLd.astro";
import heroPortrait from "@/assets/images/daniela-hero.webp";
import heroPlate from "@/assets/images/daniela-hero-plate.webp";
import { AREAS, SITE, whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";

// El hero no lleva titular, rótulo ni párrafo —instrucción explícita de la
// clienta—: solo la fotografía y los dos accesos de contacto. El H1 vive
// oculto para lectores de pantalla y buscadores; el título y la meta
// description hacen el resto del trabajo de SEO. La composición fotográfica
// (placa enmarcada en desktop, pantalla completa en móvil) es la misma que
// el sitio ya tenía aprobada — solo se le quita el texto, no la foto.

// Enrutador por situación: la persona que llega asustada se reconoce en
// una de estas cuatro (ver PRODUCT.md → Users) y encuentra de inmediato
// a qué página ir, sin que el home le repita el contenido de esa página.
const situations = [
  {
    situation: "Te llegó una citación",
    answer:
      "Antes de asistir a cualquier diligencia, busca asesoría: lo que digas desde el primer momento puede definir el rumbo del proceso.",
    whatsappMessage:
      "Hola Daniela, me citaron a la Fiscalía y necesito asesoría antes de asistir.",
  },
  {
    situation: "Capturaron a un familiar",
    answer:
      "Es el momento donde la defensa técnica es más urgente: dentro de las 36 horas siguientes se define la legalización y la posible medida de aseguramiento.",
    whatsappMessage: "Hola Daniela, capturaron a un familiar y necesito asesoría urgente.",
  },
  {
    situation: "Enfrentas una investigación o un proceso penal en curso",
    answer:
      "Si tú o un familiar se encuentran vinculados en una investigación o proceso penal, cuéntame tu situación. Analizaremos las particularidades del caso y las alternativas jurídicas para construir una estrategia de defensa.",
    whatsappMessage:
      "Hola Daniela, tengo una investigación o proceso penal en curso y necesito asesoría.",
  },
  {
    situation: "Eres víctima o acompañas a un familiar",
    answer:
      "Puedes ser representada dentro de un proceso penal ya en curso, o para iniciar uno.",
    whatsappMessage:
      "Hola Daniela, soy víctima (o acompaño a un familiar) en un proceso penal y necesito asesoría.",
  },
];

---

<Layout
  title="Abogada Penalista en Medellín — Defensa, Víctimas y Criminalidad Organizada"
  description="Daniela Jaramillo, abogada penalista en Medellín. Ocho años en la Fiscalía General de la Nación, unidad contra el crimen organizado. Defensa penal, representación de víctimas y delitos complejos."
  path="/"
>
  <!-- HERO: la misma composición en dos partes que ya tenía el sitio
       aprobada —foto a pantalla completa en móvil, placa de retrato
       enmarcada en desktop—, sin ningún texto: ni titular, ni rótulo, ni
       párrafo, por instrucción explícita de la clienta. El H1 vive oculto
       para SEO/accesibilidad; los únicos elementos visibles son el filete
       de oro y los dos accesos de contacto. Fondo sólido `manila-100`
       —mismo tono que el resto de heros de página interna (perfil,
       servicios, proceso-penal, contacto)—, con el degradado inferior de
       la foto móvil recoloreado a juego. Como única marca distintiva del
       hero del home (el resto usan la placa vertical `sello-400`/
       `sello-300`+`shadow-gold`), el filete de entrada se saca del bloque
       móvil y pasa a vivir a nivel de `<section>`: cruza todo el ancho en
       ambos viewports, marcando el umbral del sitio — ningún otro hero
       lo lleva. Las dos secciones siguientes intercambian su fondo para
       conservar la alternancia manila-100/50 del ritmo de página (ver
       DESIGN.md → Ritmo de página) ahora que el hero pasa a manila-100. -->
  <section class="relative border-b border-manila-300 bg-manila-100">
    <h1 class="sr-only">
      Daniela Jaramillo, abogada penalista en Medellín. Defensa penal, representación de
      víctimas y criminalidad organizada.
    </h1>

    {/* Filete de entrada: marca el umbral del sitio en ambos viewports —
        único hero del sitio que lleva esta línea, exclusiva del home. */}
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sello-400 to-transparent"
      aria-hidden="true"
    ></div>

    {/* ── Móvil / tablet: foto a pantalla completa, solo imagen y botones ── */}
    <div class="relative h-[calc(100svh-4rem)] min-h-[38rem] overflow-hidden lg:hidden">
      <div class="hero-drift absolute inset-0">
        <Picture
          src={heroPortrait}
          alt={`${SITE.name}, abogada penalista en Medellín, en su oficina`}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[480, 640, 900]}
          sizes="100vw"
          class="hero-settle h-full w-full object-cover object-[center_18%]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-[62%] bg-gradient-to-t from-manila-100 via-manila-100/80 to-transparent md:h-[78%]"
        aria-hidden="true"
      ></div>

      <div class="relative flex h-full items-end pb-10">
        <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
          <span class="rule-gold rule-draw block w-16" aria-hidden="true" style="--rise-delay: 0ms"></span>

          <div class="hero-rise mt-6 flex gap-3" style="--rise-delay: 200ms">
            <a href="/contacto" class="btn-gold flex-1 !px-4 whitespace-nowrap">
              Agenda tu cita
            </a>
            <a
              href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
              target="_blank"
              rel="noopener noreferrer"
              data-whatsapp-primary
              class="btn-outline-gold flex-1 !px-4 whitespace-nowrap"
            >
              Cuéntanos
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* ── Desktop: texto a la izquierda, placa de retrato a la derecha ──
         Por instrucción explícita de la clienta el hero desktop pasa a
         llevar título y descripción visibles (revierte la regla previa de
         "cero texto en el hero"; ver DESIGN.md). El H2 visual convive con
         el H1 sr-only de arriba (contenido SEO más completo, expuesto solo
         en móvil por estar en el bloque `lg:hidden`), así que la jerarquía
         de encabezados de la página sigue teniendo un único H1 expuesto en
         cada viewport. La placa conserva su marco/passe-partout propio del
         home, sin cambios de tratamiento fotográfico. */}
    <div class="hidden lg:block">
      <div class="mx-auto max-w-6xl px-8 py-24 xl:py-28">
        <div class="grid grid-cols-12 items-center gap-10 xl:gap-16">
          <div class="col-span-6 flex flex-col items-start gap-7">
            <span class="rule-gold rule-draw block w-14" aria-hidden="true" style="--rise-delay: 0ms"></span>

            <h2
              class="hero-rise font-display text-4xl font-semibold leading-[1.08] text-ink-900 xl:text-[3.25rem]"
              style="--rise-delay: 90ms"
            >
              Defensa penal estratégica
            </h2>

            <p class="hero-rise max-w-md text-lg leading-relaxed text-manila-700" style="--rise-delay: 170ms">
              Acompañamiento y representación jurídica en procesos penales, con un análisis
              riguroso de cada caso.
            </p>

            <div class="hero-rise flex flex-nowrap items-center gap-3" style="--rise-delay: 230ms">
              <a href="/contacto" class="btn-gold !px-6 whitespace-nowrap text-center">
                Agenda tu cita
              </a>
              <a
                href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
                target="_blank"
                rel="noopener noreferrer"
                data-whatsapp-primary
                class="btn-outline-gold !px-6 whitespace-nowrap text-center"
              >
                Cuéntanos tu situación
              </a>
            </div>
          </div>

          {/* La placa: canto nítido, sin degradado. El filete desplazado
              detrás (passe-partout) es el único motivo decorativo. */}
          <div class="hero-rise relative col-start-7 col-span-6" style="--rise-delay: 130ms">
            <div class="absolute -right-5 -top-5 h-full w-full border border-sello-400" aria-hidden="true"></div>
            <div class="hero-settle relative aspect-[2/3] overflow-hidden border border-ink-900/10 bg-manila-100 shadow-panel">
              <Picture
                src={heroPlate}
                alt={`${SITE.name}, abogada penalista en Medellín, en su oficina`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[480, 640, 760, 900]}
                sizes="(min-width: 1280px) 44vw, 50vw"
                class="h-full w-full object-cover object-[42%_16%]"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ¿QUÉ TE ESTÁ PASANDO?: enrutador por situación, no por trayectoria
       —esa historia vive en /perfil—. Índice de texto limpio, sin foto ni
       columna sticky, mismo tratamiento que "Áreas de práctica" más abajo. -->
  <section class="bg-manila-50 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl" data-reveal>
        ¿Qué te está pasando?
      </h2>
      <p class="mt-4 max-w-md text-manila-700" data-reveal style="--reveal-delay: 60ms">
        Reconoce tu situación y describe con claridad lo que estás enfrentando.
      </p>

      <div
        class="mt-8 divide-y divide-manila-300 border-t border-manila-300"
        data-reveal
        style="--reveal-delay: 100ms"
      >
        {
          situations.map((item) => (
            <div class="py-6">
              <p class="font-display text-lg font-semibold text-ink-900 sm:text-xl">
                {item.situation}
              </p>
              <p class="mt-2 max-w-md text-sm leading-relaxed text-manila-700">{item.answer}</p>
              <a
                href={whatsappLink(item.whatsappMessage)}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-block text-xs font-semibold uppercase tracking-[0.1em] text-sello-700 no-underline hover:text-sello-600"
              >
                Escríbeme →
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ÁREAS DE PRÁCTICA: reemplaza el antiguo índice de páginas del sitio
       —leía como un itinerario, no como el trabajo de una abogada
       penalista—. Cada área es una fila que se expande al abrirla
       (<details> nativo, funciona sin JS), con las mismas esquineras
       doradas que usaba el antiguo AreaCard.astro (eliminado tras el
       rediseño de /servicios con índice fijo + fichas), en formato de
       lista editorial resumido — la ficha completa de cada área vive en
       /servicios. -->
  <section class="bg-manila-100 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
          Áreas de práctica
        </h2>
        <a
          href="/servicios"
          class="text-xs font-semibold uppercase tracking-[0.1em] text-sello-700 no-underline hover:text-sello-600"
        >
          Ver todos los servicios →
        </a>
      </div>

      <div
        class="mt-8 divide-y divide-manila-300 border-t border-manila-300"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        {
          AREAS.map((area) => (
            <details class="area-row group py-6">
              <summary class="relative -mx-4 -my-2 flex cursor-pointer list-none items-center justify-between gap-6 rounded-none px-4 py-2 marker:content-none transition-[background-color,box-shadow] duration-200 group-hover:bg-manila-100 group-hover:shadow-gold sm:-mx-6 sm:px-6">
                <span
                  class="pointer-events-none absolute -left-3 -top-3 h-4 w-4 border-l border-t border-sello-500 opacity-0 transition-opacity group-hover:opacity-100 group-open:opacity-100"
                  aria-hidden="true"
                />
                <span
                  class="pointer-events-none absolute -bottom-3 -right-3 h-4 w-4 border-b border-r border-sello-500 opacity-0 transition-opacity group-hover:opacity-100 group-open:opacity-100"
                  aria-hidden="true"
                />
                <span class="font-display text-2xl font-semibold text-ink-900 transition-colors group-hover:text-sello-700 sm:text-3xl">
                  {area.title}
                </span>
                <span
                  class="shrink-0 text-xl font-light text-sello-600 transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <div class="mt-4 max-w-xl">
                <p class="text-sm leading-relaxed text-manila-700 sm:text-base">{area.short}</p>
                <a
                  href={`/servicios#area-${area.slug}`}
                  class="mt-3 inline-block text-xs font-semibold uppercase tracking-[0.1em] text-sello-700 no-underline hover:text-sello-600"
                >
                  Ver el servicio completo →
                </a>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <JsonLd
    schema={{
      "@context": "https://schema.org",
      "@type": "Attorney",
      name: SITE.name,
      url: SITE.url,
      image: `${SITE.url}/og/default.png`,
      telephone: SITE.phoneE164,
      email: SITE.email,
      areaServed: {
        "@type": "City",
        name: SITE.city,
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: SITE.city,
        addressRegion: SITE.region,
        addressCountry: "CO",
      },
      knowsAbout: AREAS.map((a) => a.title),
      hasCredential: [
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "degree",
          name: "Abogada — Universidad EAFIT",
        },
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "postgraduate degree",
          name: "Especialista en Derecho Procesal Penal — UNAULA",
        },
        {
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "postgraduate degree",
          name: "Magíster en Derecho Procesal Penal y Teoría del Delito — UNAULA",
        },
      ],
    }}
  />
</Layout>
