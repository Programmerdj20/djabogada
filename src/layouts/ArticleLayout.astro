---
import Layout from "@/layouts/Layout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { SITE } from "@/lib/site";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"articulos">;
}
const { entry } = Astro.props;
const { title, description, date, updated, readingMinutes, area } = entry.data;

const areaLabel: Record<string, string> = {
  "defensa-penal": "Defensa penal",
  "representacion-de-victimas": "Representación de víctimas",
  "criminalidad-organizada": "Criminalidad organizada",
  "proceso-penal": "Proceso penal",
};

// timeZone: "UTC" — see ArticleCard.astro: keeps the displayed date matching
// the frontmatter regardless of the build machine's local timezone.
const formattedDate = date.toLocaleDateString("es-CO", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout title={title} description={description} path={`/articulos/${entry.id}`} type="article">
  <article>
    <header class="border-b border-ink-800 bg-ink-950 py-14 sm:py-20">
      <div class="mx-auto max-w-3xl px-5 sm:px-8">
        <p class="folio-kicker flex flex-wrap items-center gap-x-3 gap-y-1 text-sello-500">
          <a href="/articulos" class="text-sello-500 no-underline hover:text-sello-400">Artículos</a>
          <span class="text-ink-600" aria-hidden="true">·</span>
          <span class="text-ink-400">{areaLabel[area]}</span>
        </p>
        <h1 class="mt-4 font-display text-3xl font-semibold leading-tight text-manila-50 sm:text-4xl">
          {title}
        </h1>
        <p class="folio-kicker mt-5 text-ink-500">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          <span aria-hidden="true"> · </span>
          {readingMinutes} min de lectura
        </p>
      </div>
    </header>

    <div class="bg-manila-50 py-14 sm:py-20">
      <div class="prose-expediente mx-auto max-w-3xl px-5 sm:px-8">
        <slot />
      </div>

      <div class="mx-auto mt-14 max-w-3xl border-t border-manila-300 px-5 pt-8 sm:px-8">
        <p class="text-sm text-manila-700">
          Este artículo tiene fines informativos y no sustituye una consulta jurídica sobre tu
          caso particular.
        </p>
        <a
          href="/contacto"
          class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-sello-700 no-underline hover:text-sello-600"
        >
          Agenda una consulta →
        </a>
      </div>
    </div>
  </article>

  <JsonLd
    schema={{
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description,
      datePublished: date.toISOString(),
      dateModified: (updated ?? date).toISOString(),
      author: { "@type": "Person", name: SITE.name, url: SITE.url },
      publisher: { "@type": "Person", name: SITE.name },
      mainEntityOfPage: `${SITE.url}/articulos/${entry.id}`,
    }}
  />
</Layout>
