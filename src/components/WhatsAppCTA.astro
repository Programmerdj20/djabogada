---
import { whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";
---

<a
  id="whatsapp-float-cta"
  href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
  target="_blank"
  rel="noopener noreferrer"
  class="group fixed bottom-5 right-5 z-40 flex items-center no-underline transition-opacity duration-200 focus-visible:outline-none sm:bottom-6 sm:right-6"
  aria-label="Escribir por WhatsApp a Dra. Daniela Jaramillo"
>
  <span
    aria-hidden="true"
    class="mr-3 hidden origin-right -translate-x-2 whitespace-nowrap bg-manila-50 px-3 py-2 text-xs font-semibold uppercase tracking-[0.1em] text-ink-950 opacity-0 shadow-panel transition duration-200 ease-out group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100 motion-reduce:transition-none [@media(hover:hover)]:inline-block"
  >
    Consulta directa por WhatsApp
  </span>
  <span
    class="grid size-13 shrink-0 place-items-center rounded-full bg-sello-400 text-ink-950 shadow-gold transition duration-200 ease-out group-hover:-translate-y-0.5 group-hover:bg-sello-300 group-focus-visible:-translate-y-0.5 group-focus-visible:bg-sello-300 group-focus-visible:ring-2 group-focus-visible:ring-ink-950 group-focus-visible:ring-offset-2 group-focus-visible:ring-offset-manila-50 motion-reduce:transition-none motion-reduce:transform-none sm:size-14"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[22px] sm:size-6">
      <path
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.39 1.26 4.81L2 22l5.42-1.34a9.9 9.9 0 0 0 4.62 1.15h.01c5.46 0 9.9-4.45 9.9-9.91S17.5 2 12.04 2Zm0 18.13a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.22.8.86-3.13-.2-.32a8.15 8.15 0 0 1-1.27-4.34c0-4.53 3.69-8.22 8.23-8.22 4.53 0 8.22 3.69 8.22 8.22 0 4.54-3.69 8.32-8.13 8.32Zm4.5-6.16c-.25-.12-1.46-.72-1.68-.8-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.96-.14.16-.29.18-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.22-1.45-1.37-1.7-.14-.24-.02-.37.11-.5.11-.11.25-.29.37-.43.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.3-.23.24-.86.84-.86 2.04 0 1.2.88 2.37 1 2.53.12.16 1.73 2.64 4.2 3.7.59.25 1.05.4 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.46-.6 1.67-1.17.2-.58.2-1.08.14-1.18-.06-.1-.22-.16-.47-.28Z"
      ></path>
    </svg>
  </span>
</a>

<script>
  const floatCta = document.getElementById("whatsapp-float-cta");
  const primaryLinks = document.querySelectorAll<HTMLElement>("[data-whatsapp-primary]");

  if (floatCta && primaryLinks.length) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          visible.add(entry.target);
        } else {
          visible.delete(entry.target);
        }
      }
      const shouldHide = visible.size > 0;
      floatCta.classList.toggle("opacity-0", shouldHide);
      floatCta.classList.toggle("pointer-events-none", shouldHide);
      floatCta.toggleAttribute("inert", shouldHide);
    });
    primaryLinks.forEach((el) => observer.observe(el));
  }
</script>
