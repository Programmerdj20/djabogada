---
import type { Area } from "@/lib/site";

interface Props {
  area: Area;
  compact?: boolean;
}
const { area, compact = false } = Astro.props;
---

<article
  class="group relative flex flex-col justify-between border border-manila-300 bg-manila-100 p-6 transition-all hover:-translate-y-1 hover:border-sello-500 hover:shadow-gold sm:p-8"
>
  <span class="pointer-events-none absolute left-0 top-0 h-5 w-5 border-l border-t border-sello-500 opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true"></span>
  <span class="pointer-events-none absolute bottom-0 right-0 h-5 w-5 border-b border-r border-sello-500 opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true"></span>

  <div>
    <h3 class="font-display text-2xl font-semibold text-ink-900">{area.title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-manila-700">{area.short}</p>

    {
      !compact && (
        <ul class="mt-5 space-y-2 border-t border-manila-300 pt-5 text-sm text-manila-700">
          {area.bullets.map((b) => (
            <li class="flex gap-2">
              <span class="mt-0.5 text-sello-600" aria-hidden="true">
                —
              </span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
