---
// An authored medallion graphic — every word on it is a real, verifiable
// fact (Registro Nacional de Abogados, T.P. number, seccional). Nothing
// invented.
import { SITE } from "@/lib/site";

interface Props {
  class?: string;
};
const { class: className = "" } = Astro.props;
---

<div class={`relative inline-flex ${className}`} role="img" aria-label={`Tarjeta profesional verificada número ${SITE.tarjetaProfesional}, ${SITE.tarjetaProfesionalConsejo}`}>
  <svg viewBox="0 0 140 140" class="h-full w-full" aria-hidden="true">
    <defs>
      <path id="seal-top-arc" d="M 15,70 A 55,55 0 0 1 125,70" fill="none" />
      <path id="seal-bottom-arc" d="M 22,96 A 55,55 0 0 0 118,96" fill="none" />
    </defs>
    {/* Opaque backing disc: the medallion reads against any photo behind
        it, never relying on the underlying image for contrast. */}
    <circle cx="70" cy="70" r="67" style="fill: var(--color-manila-50); stroke: var(--color-sello-500);" stroke-width="1.5" />
    <circle cx="70" cy="70" r="59" fill="none" style="stroke: var(--color-sello-400);" stroke-width="1" />
    <text font-family="var(--font-sans)" font-size="7.4" font-weight="700" letter-spacing="2.4" style="fill: var(--color-sello-700);">
      <textPath href="#seal-top-arc" startOffset="50%" text-anchor="middle">REGISTRO NAL. DE ABOGADOS</textPath>
    </text>
    <text font-family="var(--font-sans)" font-size="7.4" font-weight="700" letter-spacing="2.4" style="fill: var(--color-sello-700);">
      <textPath href="#seal-bottom-arc" startOffset="50%" text-anchor="middle">SECC. ANTIOQUIA</textPath>
    </text>
    <text x="70" y="63" text-anchor="middle" font-family="var(--font-sans)" font-size="8" font-weight="600" letter-spacing="1.5" style="fill: var(--color-sello-700);">T.P. N.°</text>
    <text x="70" y="90" text-anchor="middle" font-family="var(--font-display)" font-weight="600" font-size="22" style="fill: var(--color-ink-900);">{SITE.tarjetaProfesional}</text>
  </svg>
</div>
