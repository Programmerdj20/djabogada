---
import PageHero from "@/components/PageHero.astro";
import FAQ, { type FaqItem } from "@/components/FAQ.astro";
import JsonLd from "@/components/JsonLd.astro";
import type { Area } from "@/lib/site";
import { SITE, whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";

interface Props {
  area: Area;
  lead: string;
  narrative: string[];
  faqs: FaqItem[];
}
const { area, lead, narrative, faqs } = Astro.props;
---

<PageHero folio={`02.${area.number}`} kicker="Áreas de práctica" title={area.title} lead={lead} />

<section class="bg-manila-50 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="prose-expediente">
        {narrative.map((p) => <p>{p}</p>)}
      </div>
      <aside class="h-fit rounded-sm border border-manila-300 bg-manila-100 p-6 sm:p-8">
        <p class="folio-kicker text-sello-600">Cómo se trabaja esta área</p>
        <ul class="mt-4 space-y-3">
          {
            area.bullets.map((b) => (
              <li class="flex gap-2 text-sm leading-relaxed text-manila-700">
                <span class="mt-0.5 text-sello-600" aria-hidden="true">
                  —
                </span>
                <span>{b}</span>
              </li>
            ))
          }
        </ul>
        <a
          href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-sm bg-sello-600 px-5 py-3 text-sm font-semibold text-manila-50 no-underline hover:bg-sello-500"
        >
          Consultar por WhatsApp
        </a>
        <a
          href="/contacto"
          class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-sm border border-manila-300 px-5 py-3 text-sm font-semibold text-ink-900 no-underline hover:border-manila-400"
        >
          Ir al formulario
        </a>
      </aside>
    </div>
  </div>
</section>

<section class="bg-ink-900 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-5 sm:px-8">
    <p class="folio-kicker text-sello-500">Preguntas frecuentes</p>
    <h2 class="mt-2 font-display text-3xl font-semibold text-manila-50">
      Sobre {area.title.toLowerCase()}
    </h2>
    <div class="mt-8">
      <FAQ items={faqs} />
    </div>
  </div>
</section>

<JsonLd
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "LegalService",
      name: `${area.title} — ${SITE.name}`,
      description: area.description,
      areaServed: { "@type": "City", name: SITE.city },
      provider: { "@type": "Attorney", name: SITE.name, url: SITE.url },
      url: `${SITE.url}/areas/${area.slug}`,
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: SITE.url },
        { "@type": "ListItem", position: 2, name: "Áreas", item: `${SITE.url}/areas` },
        { "@type": "ListItem", position: 3, name: area.title, item: `${SITE.url}/areas/${area.slug}` },
      ],
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    },
  ]}
/>
