---
interface Props {
  folio: string;
  kicker: string;
  title: string;
  lead?: string;
}
const { folio, kicker, title, lead } = Astro.props;
---

<section class="border-b border-ink-800 bg-ink-950 py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <p class="folio-kicker flex flex-wrap items-center gap-x-3 gap-y-1 text-sello-500">
      <span>Expediente N.° {folio}</span>
      <span class="text-ink-600" aria-hidden="true">·</span>
      <span class="text-ink-400">{kicker}</span>
    </p>
    <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold leading-tight text-manila-50 sm:text-5xl">
      {title}
    </h1>
    {lead && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-300">{lead}</p>}
  </div>
</section>
