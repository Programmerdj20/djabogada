---
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<section class="border-b border-ink-800 bg-ink-950 py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <h1 class="max-w-3xl font-display text-4xl font-semibold leading-tight text-manila-50 sm:text-5xl">
      {title}
    </h1>
    {lead && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-300">{lead}</p>}
  </div>
</section>
