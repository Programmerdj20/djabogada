---
import { NAV_ITEMS, SITE, whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-manila-300 bg-manila-100 text-manila-700">
  <span class="rule-gold mx-auto block max-w-6xl" aria-hidden="true"></span>
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr_1fr]">
      <div>
        <p class="font-display text-2xl text-ink-900">DANIELA JARAMILLO | ABOGADA PENALISTA</p>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-manila-700">
          Ocho años construyendo el caso de la Fiscalía; hoy, al servicio de
          tu defensa.
        </p>
      </div>

      <div>
        <p class="block-label text-sello-700">Índice</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            NAV_ITEMS.map((item) => (
              <li>
                <a href={item.href} class="text-ink-700 no-underline hover:text-sello-600">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="block-label text-sello-700">Contacto</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
              class="text-ink-700 no-underline hover:text-sello-600"
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp: {SITE.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="text-ink-700 no-underline hover:text-sello-600">
              {SITE.email}
            </a>
          </li>
          <li class="text-manila-700">{SITE.city}, {SITE.region}, {SITE.country}</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-manila-300 pt-6 text-xs text-manila-700 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.name}. Todos los derechos reservados.</p>
      <div class="flex flex-wrap gap-x-5 gap-y-1">
        <a href="/aviso-legal" class="text-manila-700 no-underline hover:text-ink-700">Aviso legal</a>
        <a href="/politica-de-privacidad" class="text-manila-700 no-underline hover:text-ink-700"
          >Política de privacidad</a
        >
        <a href="/politica-de-cookies" class="text-manila-700 no-underline hover:text-ink-700"
          >Política de cookies</a
        >
      </div>
    </div>
  </div>
</footer>
