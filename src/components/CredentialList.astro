---
import { CREDENTIALS } from "@/lib/site";
---

<ul class="divide-y divide-manila-300 rounded-sm border border-manila-300 bg-manila-100">
  {
    CREDENTIALS.map((c) => (
      <li class="flex flex-col gap-1 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:px-6">
        <div class="flex items-start gap-4">
          <span class="folio-kicker mt-1 shrink-0 text-sello-600">{c.tag}</span>
          <div>
            <p class="font-medium text-ink-900">{c.title}</p>
            <p class="text-sm text-manila-700">{c.org}</p>
          </div>
        </div>
        <span class="folio-kicker shrink-0 text-manila-400 sm:pl-4">{c.year}</span>
      </li>
    ))
  }
</ul>
