---
import { Image } from "astro:assets";
import { NAV_ITEMS, SITE, whatsappLink, WHATSAPP_DEFAULT_MESSAGE } from "@/lib/site";
import logoNavbar from "@/assets/brand/logo2-navbar.webp";

// build.format: 'file' emits clean-url .html files (servicios.html, not servicios/index.html),
// so Astro.url.pathname during the static build ends in `.html` (or `/index.html` for
// the home page) even though NAV_ITEMS/links use the clean served path. Strip that
// suffix before comparing, or every nav item silently fails to match as active.
const currentPath =
  Astro.url.pathname.replace(/(?:index)?\.html$/, "").replace(/\/$/, "") || "/";

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<header class="sticky top-0 z-50 border-b border-manila-200 bg-manila-125">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/" class="flex shrink-0 items-center py-4 sm:py-5 no-underline" aria-label={`${SITE.name} — inicio`}>
      <Image
        src={logoNavbar}
        alt=""
        widths={[888, 1776]}
        sizes="(min-width: 640px) 257px, 206px"
        loading="eager"
        class="h-8 w-auto sm:h-10"
      />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV_ITEMS.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class={`relative block whitespace-nowrap px-3 py-2 text-xs font-semibold uppercase tracking-[0.14em] no-underline transition-colors after:absolute after:bottom-0 after:left-3 after:right-3 after:h-px after:origin-left after:scale-x-0 after:bg-sello-500 after:transition-transform after:duration-300 hover:text-ink-950 hover:after:scale-x-100 xl:px-4 xl:after:left-4 xl:after:right-4 ${
                    active ? "text-ink-950 after:scale-x-100" : "text-ink-600"
                  }`}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a href="/contacto" class="btn-gold hidden shrink-0 whitespace-nowrap !px-5 !py-2.5 !text-[0.7rem] lg:inline-flex">
      Agenda tu consulta
    </a>

    <button
      type="button"
      id="menu-toggle"
      class="relative flex size-11 shrink-0 items-center justify-center lg:hidden"
      aria-haspopup="dialog"
      aria-controls="mobile-drawer"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <span class="menu-bar menu-bar-top" aria-hidden="true"></span>
      <span class="menu-bar menu-bar-bottom" aria-hidden="true"></span>
    </button>
  </div>
</header>

<dialog id="mobile-drawer" aria-label="Menú principal">
  <div
    class="flex h-full flex-col px-6 pt-[max(1.1rem,env(safe-area-inset-top))] pb-[max(1.5rem,env(safe-area-inset-bottom))]"
  >
    <div class="drawer-item flex items-center justify-between">
      <img src="/favicon.svg" width="30" height="30" alt="" class="shrink-0" />
      <button
        type="button"
        id="drawer-close"
        class="group relative flex size-11 shrink-0 items-center justify-center"
        aria-label="Cerrar menú"
      >
        <span
          class="absolute h-px w-5 rotate-45 bg-ink-900 transition-colors group-hover:bg-sello-600"
          aria-hidden="true"
        ></span>
        <span
          class="absolute h-px w-5 -rotate-45 bg-ink-900 transition-colors group-hover:bg-sello-600"
          aria-hidden="true"
        ></span>
      </button>
    </div>

    <nav aria-label="Principal móvil" class="drawer-nav mt-8 flex-1">
      <ul>
        {
          NAV_ITEMS.map((item) => {
            const active = isActive(item.href);
            return (
              <li class="drawer-item border-b border-manila-200 first:border-t">
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class={`group flex items-center gap-3 py-4 font-display text-2xl no-underline transition-colors sm:text-3xl ${
                    active ? "text-ink-950" : "text-ink-700 hover:text-ink-950"
                  }`}
                >
                  <span
                    class={`h-px shrink-0 bg-sello-500 transition-all duration-300 ${
                      active ? "w-6" : "w-0 group-hover:w-6"
                    }`}
                    aria-hidden="true"
                  ></span>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="drawer-item drawer-footer mt-auto space-y-4 pt-6">
      <a href="/contacto" class="btn-gold w-full !text-[0.7rem]">Agenda tu consulta</a>
      <div class="space-y-1 text-center text-xs text-manila-800">
        <a
          href={whatsappLink(WHATSAPP_DEFAULT_MESSAGE)}
          target="_blank"
          rel="noopener noreferrer"
          class="block font-semibold text-ink-700 no-underline"
        >
          WhatsApp: {SITE.phoneDisplay}
        </a>
        <p>{SITE.city} · {SITE.region}</p>
      </div>
    </div>
  </div>
</dialog>

<script>
  const toggle = document.getElementById("menu-toggle");
  const closeBtn = document.getElementById("drawer-close");
  const drawer = document.getElementById("mobile-drawer") as HTMLDialogElement | null;
  const panel = drawer?.querySelector<HTMLElement>(":scope > div") ?? null;
  const desktopQuery = window.matchMedia("(min-width: 1024px)");

  let closing = false;

  const finishClose = () => {
    if (!drawer) return;
    drawer.close();
    closing = false;
  };

  const open = () => {
    if (!drawer) return;
    closing = false;
    drawer.showModal();
    toggle?.setAttribute("aria-expanded", "true");
    requestAnimationFrame(() => drawer.classList.add("is-open"));
  };

  const close = () => {
    if (!drawer || closing) return;
    closing = true;
    toggle?.setAttribute("aria-expanded", "false");
    drawer.classList.remove("is-open");
    panel?.addEventListener("transitionend", finishClose, { once: true });
    // Respaldo: si la transición no dispara (motion reducido, pestaña oculta), cierra igual.
    setTimeout(finishClose, 400);
  };

  toggle?.addEventListener("click", open);
  closeBtn?.addEventListener("click", close);

  drawer?.addEventListener("cancel", (event) => {
    event.preventDefault();
    close();
  });

  drawer?.addEventListener("click", (event) => {
    if (event.target === drawer || (event.target as HTMLElement).closest("a")) {
      close();
    }
  });

  desktopQuery.addEventListener("change", (event) => {
    if (event.matches && drawer?.open) close();
  });
</script>
