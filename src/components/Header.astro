---
import { NAV_ITEMS, SITE } from "@/lib/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<header class="sticky top-0 z-50 bg-ink-950/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 border-b border-ink-800 px-5 sm:px-8">
    <a
      href="/"
      class="flex items-center gap-2 py-4 text-sm font-medium text-ink-100 no-underline hover:text-manila-100"
      aria-label={`${SITE.name} — inicio`}
    >
      <span
        class="flex h-7 w-7 items-center justify-center rounded-[3px] border border-brass-600/60 bg-ink-900 font-mono text-[10px] text-manila-200"
        aria-hidden="true">DJ</span
      >
      <span class="hidden sm:inline">Daniela Jaramillo Herrera</span>
      <span class="sm:hidden">D. Jaramillo</span>
    </a>

    <!-- Folder tabs: each item is cut like a hanging-file tab (angled
         shoulders), sitting flush with the others; the active tab alone
         lifts, lightens to manila, and overlaps the header's bottom edge
         so it reads as pulled forward out of the folder body below. -->
    <nav aria-label="Principal" class="hidden self-end md:block">
      <ul class="flex items-end gap-[3px]">
        {
          NAV_ITEMS.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class={`block px-5 pb-3 pt-3.5 text-sm font-medium no-underline transition-all ${
                    active
                      ? "-mb-px translate-y-0 bg-manila-100 text-ink-900 shadow-[0_-2px_6px_rgba(20,18,13,0.25)]"
                      : "translate-y-[3px] bg-ink-800 text-ink-300 hover:translate-y-0 hover:bg-ink-700 hover:text-manila-100"
                  }`}
                  style="clip-path: polygon(10% 0, 90% 0, 100% 100%, 0 100%);"
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a
      href="/contacto"
      class="hidden shrink-0 rounded-sm bg-sello-600 px-4 py-2 text-sm font-semibold text-manila-50 no-underline shadow-panel transition-colors hover:bg-sello-500 md:inline-block"
    >
      Agenda tu consulta
    </a>

    <button
      type="button"
      id="menu-toggle"
      class="flex items-center gap-2 rounded-sm border border-ink-700 px-3 py-2 text-sm text-ink-100 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span>Índice</span>
      <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
        <path d="M0 1h16M0 6h16M0 11h16" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </button>
  </div>

  <div id="mobile-nav" class="hidden border-b border-ink-800 bg-manila-100 md:hidden">
    <nav aria-label="Principal móvil" class="mx-auto max-w-6xl px-5 py-2">
      <ul class="divide-y divide-manila-300">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="flex items-center py-3 font-medium text-ink-900 no-underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/contacto" class="flex items-center py-3 font-semibold text-sello-700 no-underline">
            Agenda tu consulta
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    nav?.classList.toggle("hidden");
  });
</script>
