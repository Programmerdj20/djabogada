---
import { NAV_ITEMS, SITE } from "@/lib/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<header class="sticky top-0 z-50 border-b border-manila-300 bg-manila-50/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a
      href="/"
      class="flex shrink-0 items-center gap-3 py-4 no-underline"
      aria-label={`${SITE.name} — inicio`}
    >
      <svg width="22" height="22" viewBox="0 0 64 64" fill="none" aria-hidden="true" class="shrink-0 text-sello-600">
        <g stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M32 12v38" />
          <path d="M19 20h26" />
          <path d="M32 12l-10 8M32 12l10 8" />
          <path d="M12 20l-4.5 10a6 6 0 0 0 13 0L16 20" />
          <path d="M52 20l-4.5 10a6 6 0 0 0 13 0L56 20" />
          <path d="M24 50h16" />
        </g>
      </svg>
      <span class="whitespace-nowrap font-display text-lg tracking-wide text-ink-900 sm:text-xl">{SITE.name}</span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV_ITEMS.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class={`relative block whitespace-nowrap px-3 py-2 text-xs font-semibold uppercase tracking-[0.14em] no-underline transition-colors after:absolute after:bottom-0 after:left-3 after:right-3 after:h-px after:origin-left after:scale-x-0 after:bg-sello-500 after:transition-transform after:duration-300 hover:text-ink-950 hover:after:scale-x-100 xl:px-4 xl:after:left-4 xl:after:right-4 ${
                    active ? "text-ink-950 after:scale-x-100" : "text-ink-600"
                  }`}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a href="/contacto" class="btn-gold hidden shrink-0 whitespace-nowrap !px-5 !py-2.5 !text-[0.7rem] lg:inline-flex">
      Agenda tu consulta
    </a>

    <button
      type="button"
      id="menu-toggle"
      class="flex items-center gap-2 border border-sello-500 px-3 py-2 text-xs font-semibold uppercase tracking-[0.1em] text-ink-900 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span>Índice</span>
      <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
        <path d="M0 1h16M0 6h16M0 11h16" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </button>
  </div>

  <div id="mobile-nav" class="hidden border-b border-manila-300 bg-manila-100 lg:hidden">
    <nav aria-label="Principal móvil" class="mx-auto max-w-6xl px-5 py-2">
      <ul class="divide-y divide-manila-300">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="flex items-center py-3 text-sm font-semibold uppercase tracking-[0.08em] text-ink-900 no-underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/contacto"
            class="flex items-center py-3 text-sm font-semibold uppercase tracking-[0.08em] text-sello-700 no-underline"
          >
            Agenda tu consulta
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    nav?.classList.toggle("hidden");
  });
</script>
