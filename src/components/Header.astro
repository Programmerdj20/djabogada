---
import { Image } from "astro:assets";
import { NAV_ITEMS, SITE } from "@/lib/site";
import logoNavbar from "@/assets/brand/logo-navbar.webp";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<header class="sticky top-0 z-50 border-b border-manila-200 bg-manila-125">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/" class="flex shrink-0 items-center py-3 sm:py-5 no-underline" aria-label={`${SITE.name} — inicio`}>
      <Image
        src={logoNavbar}
        alt=""
        widths={[358, 716]}
        sizes="(min-width: 640px) 286px, 229px"
        loading="eager"
        class="h-8 w-auto sm:h-10"
      />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV_ITEMS.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class={`relative block whitespace-nowrap px-3 py-2 text-xs font-semibold uppercase tracking-[0.14em] no-underline transition-colors after:absolute after:bottom-0 after:left-3 after:right-3 after:h-px after:origin-left after:scale-x-0 after:bg-sello-500 after:transition-transform after:duration-300 hover:text-ink-950 hover:after:scale-x-100 xl:px-4 xl:after:left-4 xl:after:right-4 ${
                    active ? "text-ink-950 after:scale-x-100" : "text-ink-600"
                  }`}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a href="/contacto" class="btn-gold hidden shrink-0 whitespace-nowrap !px-5 !py-2.5 !text-[0.7rem] lg:inline-flex">
      Agenda tu consulta
    </a>

    <button
      type="button"
      id="menu-toggle"
      class="flex items-center gap-2 border border-sello-500 px-3 py-2 text-xs font-semibold uppercase tracking-[0.1em] text-ink-900 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span>Índice</span>
      <svg class="hamburger" width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
        <line x1="0" y1="1" x2="16" y2="1" />
        <line x1="0" y1="6" x2="16" y2="6" />
        <line x1="0" y1="11" x2="16" y2="11" />
      </svg>
    </button>
  </div>

  <div id="mobile-nav" class="mobile-nav border-b border-manila-200 bg-manila-125 lg:hidden" inert>
    <nav aria-label="Principal móvil" class="mx-auto max-w-6xl px-5 py-2">
      <ul class="divide-y divide-manila-300">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="flex items-center py-3 text-sm font-semibold uppercase tracking-[0.08em] text-ink-900 no-underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/contacto"
            class="flex items-center py-3 text-sm font-semibold uppercase tracking-[0.08em] text-sello-700 no-underline"
          >
            Agenda tu consulta
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("mobile-nav");

  const setOpen = (open: boolean) => {
    toggle?.setAttribute("aria-expanded", String(open));
    nav?.classList.toggle("is-open", open);
    if (!nav) return;
    if (open) {
      nav.removeAttribute("inert");
    } else {
      nav.setAttribute("inert", "");
    }
  };

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
