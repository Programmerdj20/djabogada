---
export interface FaqItem {
  question: string;
  answer: string;
}
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-ink-800 border-y border-ink-800">
  {
    items.map((item, i) => (
      <details class="group py-5">
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-4 text-manila-50 marker:content-none"
        >
          <span class="flex gap-3">
            <span class="folio-kicker mt-1 shrink-0 text-sello-500">
              P.{String(i + 1).padStart(2, "0")}
            </span>
            <span class="font-medium leading-snug">{item.question}</span>
          </span>
          <span
            class="mt-1 shrink-0 text-ink-400 transition-transform group-open:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class="mt-3 pl-[3.15rem] text-sm leading-relaxed text-ink-300">{item.answer}</p>
      </details>
    ))
  }
</div>
